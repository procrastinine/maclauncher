---
// A before/after comparison. Both images share one frame; dragging the slider
// (or using the arrow keys on it) moves the divider. Without JavaScript the
// divider stays in the middle.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
  alt: string;
  caption?: string;
  pixelated?: boolean;
  format?: "png" | "webp";
}
const { before, after, beforeLabel = "Before", afterLabel = "After", alt, caption, pixelated = false, format = "webp" } = Astro.props;
const quality = format === "webp" ? 92 : undefined;
---

<figure class:list={["ml-compare", { pixelated }]}>
  <div class="ml-compare-frame" style="--split: 50%">
    <Image src={before} alt={`${alt} (${beforeLabel})`} format={format} quality={quality} />
    <Image src={after} alt={`${alt} (${afterLabel})`} format={format} quality={quality} class="ml-compare-after" />
    <span class="ml-compare-label before" aria-hidden="true">{beforeLabel}</span>
    <span class="ml-compare-label after" aria-hidden="true">{afterLabel}</span>
    <input type="range" min="0" max="100" value="50" step="0.5" aria-label={`Divider between ${beforeLabel} and ${afterLabel}`} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>(".ml-compare-frame")) {
    const slider = frame.querySelector("input");
    slider?.addEventListener("input", () => frame.style.setProperty("--split", slider.value + "%"));
  }
</script>

<style>
  .ml-compare {
    margin: 1.75rem 0;
  }
  .ml-compare-frame {
    position: relative;
    display: grid;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    line-height: 0;
  }
  .ml-compare-frame > :global(img) {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    margin: 0;
  }
  .ml-compare-frame > :global(img.ml-compare-after) {
    clip-path: inset(0 0 0 var(--split));
  }
  .pixelated .ml-compare-frame > :global(img) {
    image-rendering: pixelated;
  }
  .ml-compare-frame::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: white;
    box-shadow: 0 0 6px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }
  .ml-compare-label {
    position: absolute;
    top: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.3rem;
    background: rgb(0 0 0 / 0.6);
    color: white;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    pointer-events: none;
  }
  .ml-compare-label.before {
    left: 0.6rem;
  }
  .ml-compare-label.after {
    right: 0.6rem;
  }
  .ml-compare-frame input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .ml-compare-frame input:focus-visible {
    opacity: 0.001;
  }
  .ml-compare-frame:has(input:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
