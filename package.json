{
  "name": "maclauncher",
  "productName": "MacLauncher",
  "license": "MIT",
  "private": true,
  "version": "0.3.1",
  "description": "Mac-first Electron launcher with modular engine support",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "launch": "node scripts/run-game.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:debug": "node scripts/dev.mjs --debug",
    "test": "node --test tests/*.test.js",
    "build": "vite build --config vite.config.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:check": "node scripts/check-packaging.cjs",
    "preview": "vite preview --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "electron:install": "install-electron --no",
    "postinstall": "node node_modules/electron/install.js",
    "deps:update": "pnpm update --latest && pnpm check && pnpm audit --audit-level high"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rpgrt": "0.2.0",
    "steam-session": "1.9.4",
    "steam-user": "5.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.maclauncher.launcher",
    "productName": "MacLauncher",
    "fileAssociations": [
      {
        "name": "Graphics shader or filter",
        "ext": [
          "fx",
          "glsl",
          "hook",
          "slang",
          "slangp"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Neural rendering model",
        "ext": [
          "dlssmodel"
        ],
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": true
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist/app"
    },
    "files": [
      "dist/renderer/**",
      "src/**",
      "package.json",
      "LICENSE",
      "!docs/**",
      "!scripts/**",
      "!src/{core,main,renderer,runtime,modules}/**/{test,tests,__tests__,fixtures}/**",
      "!src/{core,main,renderer,runtime,modules}/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}",
      "!src/{core,main,renderer,runtime,modules}/**/{test,test-*,*-test}.{c,cc,cpp,cxx,h,hpp,m,mm,fx,js,cjs,mjs,ts,tsx,py,rs,java}",
      "!**/.DS_Store",
      "!**/._*",
      "!**/.local",
      "!**/.local/**",
      "!**/.env",
      "!**/.env.*",
      "!**/localconfig*.json",
      "!**/*.log",
      "!**/*.har",
      "!**/*.pcap",
      "!**/*.heapsnapshot",
      "!**/__pycache__",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo",
      "!src/resources/**",
      "!src/modules/rgss/resources/mkxpz/**",
      "!src/modules/rgss/resources/rtp/**",
      "!src/external/**",
      "!src/renderer/**",
      "!src/**/*.d.ts",
      "!src/**/*.d.mts",
      "!src/modules/shared/reshade/native/**",
      "!src/modules/shared/reshade/neural/native/**",
      "!src/modules/shared/reshade/neural/build.mjs",
      "!src/modules/shared/reshade/libplacebo-build.mjs",
      "!src/modules/bgi/native/**",
      "!src/modules/renpy/resources/unren/**",
      "!src/modules/renpy/resources/universal-renpy-walkthrough/**",
      "!src/modules/android/native/**",
      "!src/modules/android/art/{native,java,adapters,licenses,tools,composer,graphics,sensors}/**",
      "!src/modules/android/art/*-source.mjs",
      "!src/modules/android/art/build*.mjs",
      "!src/modules/android/art/{boot-image*,composition-surface-build,core-api,dex-bodies,hal-aidl,source,package}.mjs",
      "!src/modules/android/art/{supplier,components,dex-tools}.json",
      {
        "from": "src/external/maclauncher-android",
        "to": "src/android-runtime",
        "filter": [
          "package.json",
          "src/modules/android/apk.js",
          "src/modules/android/binary-manifest.js",
          "src/modules/android/profile.js",
          "src/modules/android/art/runtime.js",
          "src/modules/android/art/boot-classpath.mjs",
          "src/modules/android/art/components.json",
          "src/modules/android/art/supplier.json",
          "src/modules/android/native/arm32/components.json",
          "src/modules/android/native/resources/ad-hosts.json",
          "src/modules/android/native/resources/storage-namespace.json",
          "src/modules/shared/runtime/zip.js"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "src/resources",
        "to": ".",
        "filter": [
          "7zip/**",
          "RPGMakerDecrypter/**",
          "maclauncher.png",
          "native-runtimes/**",
          "!native-runtimes/android",
          "!native-runtimes/android/**",
          "!native-runtimes/android-art",
          "!native-runtimes/android-art/**",
          "!native-runtimes/android-aim",
          "!native-runtimes/android-aim/**",
          "python/**",
          "!**/.DS_Store",
          "!**/._*",
          "!**/.git",
          "!**/.git/**",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "src/modules/renpy/resources/universal-renpy-walkthrough",
        "to": "renpy-cheats/universal-renpy-walkthrough",
        "filter": [
          "__urw/urw_core.rpy",
          "__urw/urw_processor.rpy",
          "__urw/urw_screens.rpy",
          "__urw/urw_updater.rpy",
          "__urw/urw_utils.rpy"
        ]
      },
      {
        "from": "src/modules/renpy/resources/unren",
        "to": "unren",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!**/__pycache__/**",
          "!**/.git",
          "!**/.git/**",
          "!**/.github/**",
          "!**/._*",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/testcases/**",
          "!third_party/unrpyc-legacy/**",
          "!third_party/**/un.rpyc",
          "!third_party/**/un.rpy",
          "!third_party/**/UnRen-dev.bat",
          "!third_party/**/UnRen.ps1",
          "!third_party/**/make-bintray-json.sh",
          "!third_party/**/bintray-template.json",
          "!third_party/**/MANIFEST.in",
          "!third_party/**/setup.py",
          "!third_party/**/setup.cfg",
          "!third_party/**/pyproject.toml"
        ]
      },
      {
        "from": "src/external",
        "to": "external",
        "filter": [
          "evbunpack/evbunpack/*.py",
          "evbunpack/LICENSE",
          "rpgmakermlinux-cicpoffs/Kawariki-patches/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/rpgmaker-mv-pixi5/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/filestoexport/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/rpgmaker-mv-pixi5/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/filestoexport/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/plugins/**",
          "!**/.DS_Store",
          "!**/.git",
          "!**/.git/**",
          "!**/._*",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "src/modules/rgss/evb-files.py",
      "src/modules/fvp/host.py",
      "src/modules/siglus/resources/native-host/macos-universal/**",
      "src/modules/android/providers/aim/resources/maclauncher-aim",
      "src/modules/vnds/resources/0.0.13-838e47b-mac-v1/**",
      "src/modules/flash/resources/flash-player/**/*.app/**",
      "src/modules/shared/reshade/shader-collection/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Selected games can record audio from the input chosen in game Settings.",
        "NSCameraUsageDescription": "Selected games can receive video from the camera chosen in game Settings."
      },
      "hardenedRuntime": true,
      "signIgnore": [
        "native-runtimes/",
        "src/modules/flash/resources/flash-player/",
        "src/modules/siglus/resources/rlvm-adapter/"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/notarize.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
