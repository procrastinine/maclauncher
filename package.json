{
  "name": "maclauncher",
  "productName": "MacLauncher",
  "license": "MIT",
  "private": true,
  "version": "0.5.0",
  "description": "Mac-first Electron launcher with modular engine support",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "launch": "node scripts/run-game.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:debug": "node scripts/dev.mjs --debug",
    "test": "node --test tests/*.test.js",
    "build": "vite build --config vite.config.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "package:check": "node scripts/check-packaging.cjs",
    "preview": "vite preview --config vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "electron:install": "install-electron --no",
    "postinstall": "node node_modules/electron/install.js",
    "deps:update": "pnpm update --latest && pnpm check && pnpm audit --audit-level high"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rpgrt": "0.2.0",
    "steam-session": "1.9.4",
    "steam-user": "5.3.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.maclauncher.launcher",
    "productName": "MacLauncher",
    "fileAssociations": [
      {
        "name": "Graphics shader or filter",
        "ext": [
          "fx",
          "glsl",
          "hook",
          "plfilter",
          "slang",
          "slangp",
          "cube",
          "fs",
          "isf",
          "hlsl",
          "mclfilter"
        ],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Neural rendering model",
        "ext": [
          "dlssmodel",
          "vsrmodel",
          "srmodel",
          "fgmodel",
          "restorationmodel",
          "depthmodel"
        ],
        "role": "Viewer",
        "rank": "Alternate",
        "isPackage": true
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist/app"
    },
    "files": [
      "dist/renderer/**",
      "src/**",
      "package.json",
      "LICENSE",
      "!docs/**",
      "!scripts/**",
      "!src/{core,main,renderer,runtime,modules}/**/{test,tests,__tests__,fixtures}/**",
      "!src/{core,main,renderer,runtime,modules}/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}",
      "!src/{core,main,renderer,runtime,modules}/**/{test,test-*,*-test}.{c,cc,cpp,cxx,h,hpp,m,mm,fx,js,cjs,mjs,ts,tsx,py,rs,java}",
      "!**/.DS_Store",
      "!**/._*",
      "!**/.local",
      "!**/.local/**",
      "!**/.env",
      "!**/.env.*",
      "!**/localconfig*.json",
      "!**/*.log",
      "!**/*.har",
      "!**/*.pcap",
      "!**/*.heapsnapshot",
      "!**/__pycache__",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo",
      "!src/resources{,/**}",
      "!src/modules/rgss/resources/mkxpz/**",
      "!src/modules/rgss/resources/rtp/**",
      "!src/external{,/**}",
      "!src/renderer{,/**}",
      "!src/**/*.d.ts",
      "!src/**/*.d.mts",
      "!src/modules/shared/reshade/native{,/**}",
      "!src/modules/shared/reshade/neural/native{,/**}",
      "!src/modules/shared/reshade/neural/build.mjs",
      "!src/modules/shared/reshade/libplacebo-build.mjs",
      "!src/modules/shared/reshade/compiler-isolation.mjs",
      "!src/modules/shared/reshade/xess/native{,/**}",
      "!src/modules/shared/reshade/isf/{CMakeLists.txt,build.mjs,isolate-compiler.mjs,provider.mm}",
      "!src/modules/shared/reshade/generation/fsr3/{build.mjs,backend.mm,metal-backend.hpp}",
      "!src/modules/crossover/temporal/vulkan/{build.mjs,overlay.mjs,source.json,*.[ch]}",
      "!src/modules/bgi/native{,/**}",
      "!src/modules/renpy/resources/unren{,/**}",
      "!src/modules/renpy/resources/universal-renpy-walkthrough{,/**}",
      "!src/modules/android/native{,/**}",
      "!src/modules/android/{managed-packages,aim-distribution}.json",
      "!src/modules/android/art/{native,java,adapters,licenses,tools,composer,graphics,sensors}{,/**}",
      "!src/modules/android/art/boot-image-driver.rs",
      "!src/modules/android/art/*-source.mjs",
      "!src/modules/android/art/build*.mjs",
      "!src/modules/android/art/{boot-image*,composition-surface-build,core-api,dex-bodies,hal-aidl,source,source-archive,source-hwui,package}.mjs",
      "!src/modules/android/art/{supplier,components,dex-tools}.json",
      "!src/modules/flash/resources/flash-player{,/**}",
      "!node_modules/undici/docs{,/**}",
      "!node_modules/smart-buffer/docs{,/**}",
      "!node_modules/steam-session/src{,/**}",
      "!node_modules/{react,react-dom,scheduler}/!(LICENSE|package.json){,/**}",
      "!node_modules/bytebuffer/dist/{bytebuffer.min.js.gz,bytebuffer-dataview.min.js.gz}",
      "!node_modules/long/dist/long.min.js.gz",
      "!src/modules/rgss/overlays/{mkxpz-config.c,mkxpz-identity.m}",
      "!src/modules/rgss/overlays/mkxpz-filename-nfc/macos-filename-nfc.{c,h}",
      "!src/modules/shared/runtime/steamworks/native/{offline-0.5.0,ticket-0.1.0}/build.cjs",
      "!src/modules/shared/runtime/steamworks/native/offline-0.5.0/source/offline.cpp",
      "!src/modules/shared/runtime/steamworks/native/ticket-0.1.0/source/ticket.cpp",
      "!src/modules/siglus/resources/{native-host,rlvm-adapter}{,/**}",
      "!src/modules/kirikiri/resources/kag3-polyfill{,/**}",
      "!src/modules/vnds/{resources/0.0.13-838e47b-mac-v1,overlays}{,/**}",
      "!src/modules/android/{arguments,text-input,store/java}{,/**}",
      "!src/modules/android/{resources/launch-arguments.jar,resources/text-input.jar,store/resources/account-control.jar,store/build-account-control.mjs,providers/macapk/build-policy.mjs}",
      "!src/modules/android/providers/macapk/{java,resources/privacy.jar}{,/**}",
      "!src/modules/android/providers/aim/{resources,controller}{,/**}",
      "!src/modules/android/providers/aim/{keeper,clipboard_bridge,runtime_prepare,socket_path}.rs",
      "!src/modules/android/providers/aim/build-controller.mjs",
      "!src/modules/catsystem2/runtime/!(crypto.js|distribution-supplementals.json){,/**}",
      "!src/modules/catsystem2/{viewport,viewport-v2}.js"
    ],
    "extraResources": [
      {
        "from": "src/resources",
        "to": ".",
        "filter": [
          "7zip/**",
          "maclauncher.png",
          "native-runtimes/**",
          "python/**",
          "!**/.DS_Store",
          "!**/._*",
          "!**/.git",
          "!**/.git/**",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "src/modules/renpy/resources/universal-renpy-walkthrough",
        "to": "renpy-cheats/universal-renpy-walkthrough",
        "filter": [
          "__urw/urw_core.rpy",
          "__urw/urw_processor.rpy",
          "__urw/urw_screens.rpy",
          "__urw/urw_updater.rpy",
          "__urw/urw_utils.rpy"
        ]
      },
      {
        "from": "src/modules/renpy/resources/unren",
        "to": "unren",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!**/__pycache__/**",
          "!**/.git",
          "!**/.git/**",
          "!**/.github/**",
          "!**/._*",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/testcases/**",
          "!third_party/unrpyc-legacy/**",
          "!third_party/**/un.rpyc",
          "!third_party/**/un.rpy",
          "!third_party/**/UnRen-dev.bat",
          "!third_party/**/UnRen.ps1",
          "!third_party/**/make-bintray-json.sh",
          "!third_party/**/bintray-template.json",
          "!third_party/**/MANIFEST.in",
          "!third_party/**/setup.py",
          "!third_party/**/setup.cfg",
          "!third_party/**/pyproject.toml"
        ]
      },
      {
        "from": "src/external",
        "to": "external",
        "filter": [
          "evbunpack/evbunpack/*.py",
          "evbunpack/LICENSE",
          "rpgmakermlinux-cicpoffs/Kawariki-patches/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/rpgmaker-mv-pixi5/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/filestoexport/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/packagefiles/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/rpgmaker-mv-pixi5/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/filestoexport/plugins/**",
          "rpgmakermlinux-cicpoffs/nwjs/nwjs/packagefiles/plugins/**",
          "!**/.DS_Store",
          "!**/.git",
          "!**/.git/**",
          "!**/._*",
          "!**/.local",
          "!**/.local/**",
          "!**/.env",
          "!**/.env.*",
          "!**/localconfig*.json",
          "!**/*.log",
          "!**/*.har",
          "!**/*.pcap",
          "!**/*.heapsnapshot",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "src/modules/rgss/evb-files.py",
      "src/modules/fvp/host.py",
      "src/modules/shared/reshade/shader-collection/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Selected games can record audio from the input chosen in game Settings.",
        "NSCameraUsageDescription": "Selected games can receive video from the camera chosen in game Settings."
      },
      "hardenedRuntime": true,
      "signIgnore": [
        "native-runtimes/"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/notarize.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  }
}
