{
  "id": "metalsharp-wine",
  "kind": "wine",
  "label": "MetalSharp Wine",
  "order": 203,
  "upstream": {
    "github": "metalsharp/MetalSharp-Wine",
    "assets": {
      "arm64": "^MetalSharp-Wine-.*-arm64\\.zip$"
    }
  },
  "included": [
    {
      "id": "metalsharp-wine-fex",
      "kind": "cpu-translator",
      "label": "MetalSharp FEX",
      "engine": "fex",
      "parts": [
        { "path": "lib/wine/aarch64-windows/libarm64ecfex.dll", "name": "arm64ec-client" },
        { "path": "lib/wine/aarch64-unix/libarm64ecfex.so", "name": "arm64ec-helper" },
        { "path": "lib/wine/aarch64-windows/libwow64fex.dll", "name": "wow64-client" },
        { "path": "lib/wine/aarch64-unix/libwow64fex.so", "name": "wow64-helper" }
      ]
    },
    {
      "id": "metalsharp-wine-moltenvk",
      "kind": "vulkan-driver",
      "label": "MetalSharp MoltenVK",
      "engine": "moltenvk",
      "parts": [
        { "path": "lib/libMoltenVK.dylib", "name": "library" },
        { "path": "share/vulkan/icd.d/MoltenVK_icd.json", "name": "icd" }
      ]
    },
    {
      "id": "metalsharp-wine-mullion",
      "kind": "d3d-translator",
      "label": "MetalSharp Mullion",
      "engine": "mullion",
      "parts": [
        { "path": "lib/mullion", "name": "mullion" }
      ]
    },
    {
      "id": "metalsharp-wine-dxvk",
      "kind": "d3d-translator",
      "label": "MetalSharp DXVK",
      "engine": "dxvk",
      "vulkan": true,
      "parts": [
        { "path": "lib/dxvk", "name": "dxvk" }
      ]
    },
    {
      "id": "metalsharp-wine-vkd3d-proton",
      "kind": "d3d-translator",
      "label": "MetalSharp vkd3d-proton",
      "engine": "vkd3d-proton",
      "vulkan": true,
      "parts": [
        { "path": "lib/vkd3d-proton", "name": "vkd3d-proton" }
      ]
    }
  ],
  "graphicsPolicy": {
    "variable": "GRAPHICS_BACKEND",
    "default": "dxmt",
    "builtins": "wine",
    "values": [
      {
        "value": "dxmt",
        "lanes": ["metalsharp-wine-mullion"],
        "directory": {
          "variable": "DXMT_RUNTIME_DIR",
          "engines": ["dxmt"],
          "files": ["aarch64-windows/dxgi.dll", "aarch64-windows/d3d11.dll", "aarch64-unix/winemetal.so"]
        }
      },
      {
        "value": "dxvk",
        "lanes": ["metalsharp-wine-dxvk", "metalsharp-wine-mullion"],
        "architectures": ["x64"]
      },
      {
        "value": "vkd3d",
        "lanes": ["metalsharp-wine-vkd3d-proton", "metalsharp-wine-dxvk", "metalsharp-wine-mullion"],
        "architectures": ["x64"]
      }
    ]
  }
}
