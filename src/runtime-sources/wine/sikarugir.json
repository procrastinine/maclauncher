  "wine": {
    "invocation": "wine",
    "prefixModel": "windowsVersion",
    "downloads": true,
    "environmentKind": "sikarugir-wrapper",
    "directDraw": true,
    "graphicsSelector": false,
    "vulkanLibrarySelector": false
  },
  "assets": [
    {
      "match": "^(?!.*(?:^|[-_.])(?:linux|windows|win(?:32|64)|android|ios|riscv[0-9]*|aarch64|debug|symbols?|dsym)(?:[-_.]|$))WS(?<wrapper>[0-9]+)WineSikarugir(?<version>(?:10\\.(?:0_(?:[89]|[1-9][0-9]+)|[1-9][0-9]*(?:_[0-9]+)?)|11\\.(?:0_[1-9][0-9]*|[1-9][0-9]*(?:_[0-9]+)?)|(?:1[2-9]|[2-9][0-9]|[1-9][0-9]{2,})\\.[0-9]+(?:_[0-9]+)?))(?:[-_.][A-Za-z][\\w.-]*)?\\.(?:tar\\.(?:xz|gz|bz2|zst)|t[gx]z|tar|zip|pkg)$",
      "declares": {
        "macho": [
          "x86_64"
        ]
      }
    }
  ],
  "automatic": {
    "vulkan-driver": [
      "sikarugir-kosmickrisp",
      "sikarugir-moltenvk"
    ],
    "d3d-renderer": [
      "sikarugir-dxmt",
      "sikarugir-wined3d"
    ],
    "d3d9": [
      {
        "embed": "sikarugir-d9vk",
        "when": {
          "setting": "d9vk",
          "not": true,
          "equals": false,
          "selected": {
            "role": "vulkan-driver",
            "engine": "kosmickrisp"
          }
        }
      },
      "sikarugir-wined3d"
    ],
    "d3d8": [
      {
        "embed": "sikarugir-d9vk",
        "when": {
          "setting": "d9vk",
          "not": true,
          "equals": false,
          "selected": {
            "role": "vulkan-driver",
            "engine": "kosmickrisp"
          }
        }
      },
      "sikarugir-wined3d"
    ],
    "legacy.dxvk": [
      {
        "embed": "sikarugir-dxvk3",
        "when": {
          "selected": {
            "role": "vulkan-driver",
            "engine": "kosmickrisp"
          }
        }
      },
      "sikarugir-dxvk"
    ]
  },
  "interfaces": {
    "provides": [
      "wine:dllpath-overlay"
    ]
  }
