        {
          "path": "Libraries/DXMT",
          "name": "dxmt"
        }
      ],
      "interfaces": {
        "requires": [
          "macos>=14.0",
          "wine:winemetal"
        ]
      },
      "engine": "dxmt",
      "label": "DXMT"
    },
    {
      "id": "winecx-dxvk",
      "kind": "d3d-translator",
      "parts": [
        {
          "path": "Libraries/DXVK",
          "name": "dxvk"
        }
      ],
      "interfaces": {
        "requires": []
      },
      "engine": "dxvk",
      "label": "DXVK"
    },
    {
      "id": "winecx-moltenvk",
      "kind": "vulkan-driver",
      "parts": [
        {
          "path": "Libraries/Wine/lib/libMoltenVK.dylib",
          "name": "moltenvk"
        }
      ],
      "interfaces": {
        "requires": []
      },
      "engine": "moltenvk",
      "label": "MoltenVK"
    },
    {
      "id": "winecx-gstreamer",
      "kind": "media",
      "parts": [
        {
          "path": "Libraries/Wine/lib/gstreamer-1.0",
          "name": "plugins"
        },
        {
          "path": "Libraries/Wine/lib/libgstreamer-1.0.0.dylib",
          "name": "core",
          "optional": true
        }
      ],
      "engine": "gstreamer",
      "label": "GStreamer"
    },
    {
      "id": "winecx-wined3d",
      "kind": "d3d-translator",
      "engine": "wined3d",
      "parts": [
        {
          "path": "Libraries/Wine/lib/wine",
          "name": "builtins"
        }
      ],
      "label": "WineD3D"
    }
  ],
