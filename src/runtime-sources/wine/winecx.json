{
  "id": "winecx",
  "kind": "wine",
  "label": "WineCX",
  "order": 202,
  "upstream": {
    "github": "dappermint/winecx-gptk",
    "assets": {
      "x86_64": "\\.(?:tar\\.(?:xz|gz|bz2|zst)|t[gx]z|tar|zip|pkg)$"
    }
  },
  "included": [
    {
      "id": "winecx-dxmt",
      "kind": "d3d-translator",
      "parts": [
        {
          "path": "Libraries/DXMT",
          "name": "dxmt"
        }
      ],
      "engine": "dxmt",
      "label": "WineCX DXMT"
    },
    {
      "id": "winecx-dxvk",
      "kind": "d3d-translator",
      "parts": [
        {
          "path": "Libraries/DXVK",
          "name": "dxvk"
        }
      ],
      "engine": "dxvk",
      "vulkan": true,
      "label": "WineCX DXVK"
    },
    {
      "id": "winecx-moltenvk",
      "kind": "vulkan-driver",
      "parts": [
        {
          "path": "Libraries/Wine/lib/libMoltenVK.dylib",
          "name": "moltenvk"
        }
      ],
      "engine": "moltenvk",
      "label": "WineCX MoltenVK"
    },
    {
      "id": "winecx-gstreamer",
      "kind": "media",
      "parts": [
        {
          "path": "Libraries/Wine/lib/gstreamer-1.0",
          "name": "plugins"
        },
        {
          "path": "Libraries/Wine/lib/libgstreamer-1.0.0.dylib",
          "name": "core",
          "optional": true
        }
      ],
      "engine": "gstreamer",
      "label": "WineCX GStreamer"
    },
    {
      "id": "winecx-wined3d",
      "kind": "d3d-translator",
      "engine": "wined3d",
      "parts": [
        {
          "path": "Libraries/Wine/lib/wine",
          "name": "builtins"
        }
      ],
      "label": "WineCX WineD3D"
    }
  ]
}
