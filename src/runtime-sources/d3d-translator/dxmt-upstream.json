{
  "id": "dxmt-upstream",
  "kind": "d3d-translator",
  "label": "DXMT",
  "order": 0,
  "manager": {
    "id": "sikarugir-graphics-bridge",
    "sectionId": "upstream",
    "engine": "dxmt",
    "memberOrder": 0,
    "sectionLabel": "DXMT",
    "formerIds": [
      "crossover-graphics-bridge"
    ]
  },
  "discover": {
    "type": "github-releases",
    "repo": "3Shain/dxmt",
    "includePrereleases": true
  },
  "assets": [
    {
      "match": "^(?=.*[Bb][Uu][Ii][Ll][Tt][Ii][Nn]).*\\.(?:[zZ][iI][pP]|[tT][aA][rR]\\.[gG][zZ]|[tT][gG][zZ]|[tT][aA][rR]\\.[xX][zZ]|[tT][aA][rR]\\.[zZ][sS][tT]|[tT][xX][zZ]|[tT][aA][rR]\\.[bB][zZ]2|[tT][bB][zZ]2|[dD][mM][gG]|[tT][aA][rR]|[pP][kK][gG])$",
      "declares": {
        "pe": [
          "i386",
          "x86_64"
        ]
      },
      "parts": [
        {
          "path": "dxmt",
          "name": "component-root",
          "optional": true
        }
      ]
    }
  ],
  "verify": [
    {
      "type": "github-asset-digest"
    }
  ],
  "layout": {
    "type": "archive"
  },
  "interfaces": {
    "requires": [
      "api:metal",
      "macos>=14.0",
      "wine:winemetal"
    ]
  },
  "labels": {
    "source": "DXMT"
  },
  "license": "LGPL-2.1-or-later",
  "credits": {
    "url": "https://github.com/3Shain/dxmt"
  }
}
