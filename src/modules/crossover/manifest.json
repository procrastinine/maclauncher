      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "sikarugir"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.executableArchitecture",
        "label": "Windows CPU"
      },
      {
        "key": "moduleData.executablePath",
        "label": "Executable",
        "format": "path"
      },
      {
        "key": "runtimeData.crossover.applicationPath",
        "label": "CrossOver application",
        "format": "path"
      }
    ],
    "actions": [
      {
        "id": "revealWindowsFiles",
        "label": "Open Windows files",
        "kind": "secondary"
      }
    ],
    "actionGroups": [
      {
        "id": "windows",
        "label": "Windows",
