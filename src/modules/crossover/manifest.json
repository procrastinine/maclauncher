                }
              ],
              "description": "Availability depends on the selected Wine version, Mac and macOS version."
            },
            {
              "key": "dlss",
              "type": "boolean",
              "label": "Game temporal integration",
              "description": "Expose the game's DLSS option through MetalFX Temporal. A shared temporal upscaler also enables this integration automatically. Requires Apple Silicon and DXMT on macOS 14 or later, or D3DMetal on macOS 26 or later, with matching NVAPI/NGX libraries. DLSS must be enabled in the game settings. Changes apply on the next launch.",
              "hiddenWhen": [
                {
                  "key": "graphicsBackend",
                  "equals": "dxvk"
