{
  "id": "godot",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "extensions": [
      {
        "extension": ".pck",
        "exclusive": true
      }
    ],
    "fileExtensions": [
      ".pck",
      ".exe"
    ],
    "binaryFormats": [
      "pe",
      "elf",
      "godot"
    ],
    "rootMarkers": [
      "project.godot",
      "project.binary",
      "engine.cfg",
      "engine.cfb",
      "Contents/Resources"
    ],
    "rootExtensions": [
      ".pck"
    ],
    "containerFormats": [
      "pe",
      "elf",
      "godot"
    ],
    "directFileExtensions": [
      ".pck"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".pck"
    ],
    "probeExecutables": true,
    "worker": true
  },
  "family": "engine",
  "label": "Godot",
  "shortLabel": "Godot",
  "gameType": "engine",
  "runtime": {
    "managerUi": {
      "godot": {
        "tabLabel": "Godot",
        "order": 40,
        "management": "managed"
      }
    },
    "default": "godot",
    "supported": [
      "godot",
      "native"
    ],
    "entries": {
      "godot": {
        "label": "Godot",
        "settings": {
          "defaults": {
            "preferExtracted": false
          },
          "fields": [
            {
              "key": "preferExtracted",
              "type": "boolean",
              "label": "Prefer extracted project",
              "description": "Launch recovered project files when available."
            }
          ]
        }
      },
      "native": {
        "label": "Native app"
      }
    },
    "labels": {
      "godot": "Godot",
      "native": "Native app"
    },
    "manager": {
      "godot": "godot"
    },
    "preLaunch": {
      "godot": {
        "statusAction": "runtimeStatus",
        "readyWhen": {
          "key": "ready",
          "equals": true
        },
        "fixAction": "installRuntime",
        "declineAction": "suppressRuntimePrompt",
        "prompt": "This game needs the detected Godot runtime before it can launch. Install it now?"
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "godot"
  },
  "ui": {
    "actions": [
      {
        "id": "downloadDetectedRuntime",
        "label": "Download detected version",
        "kind": "primary",
        "icon": "download",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.detectedMajor",
            "falsy": true
          }
        ]
      },
      {
        "id": "gdreReload",
        "label": "Reload",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "extractStatusLabel",
            "label": "Status"
          },
          {
            "key": "extractedAt",
            "label": "Last extract",
            "format": "date"
          }
        ]
      },
      {
        "id": "revealExtraction",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "gdreDetectVersion",
        "label": "Detect version",
        "kind": "secondary"
      },
      {
        "id": "gdreExtract",
        "label": "Extract",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "truthy": true
          }
        ]
      },
      {
        "id": "gdreRecover",
        "label": "Full recovery",
        "kind": "secondary"
      },
      {
        "id": "removeExtraction",
        "label": "Remove Extracted",
        "kind": "danger",
        "confirm": "Remove extracted Godot files?",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "version-detection",
        "label": "Version detection",
        "actions": [
          "downloadDetectedRuntime"
        ],
        "infoFields": [
          {
            "key": "moduleData.detectedLabel",
            "label": "",
            "empty": "Unknown"
          }
        ]
      },
      {
        "id": "gdre-tools",
        "label": "Extract",
        "actions": [
          "gdreReload",
          "revealExtraction",
          "gdreDetectVersion",
          "gdreExtract",
          "removeExtraction"
        ]
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "Godot",
      "url": "https://github.com/godotengine/godot"
    },
    {
      "label": "gdsdecomp",
      "url": "https://github.com/GDRETools/gdsdecomp"
    }
  ]
}
