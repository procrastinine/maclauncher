{
  "id": "love",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "extensions": [
      {
        "extension": ".love",
        "exclusive": true
      },
      {
        "extension": ".appimage",
        "exclusive": true
      }
    ],
    "fileExtensions": [
      ".love",
      ".appimage",
      ".exe"
    ],
    "binaryFormats": [
      "elf"
    ],
    "rootMarkers": [
      "main.lua",
      "love.dll",
      "lib",
      "Contents/Resources"
    ],
    "rootExtensions": [
      ".love"
    ],
    "containerFormats": [
      "zip",
      "appimage"
    ],
    "directFileExtensions": [
      ".love",
      ".appimage"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".love",
      ".appimage"
    ],
    "probeExecutables": true,
    "worker": true
  },
  "family": "engine",
  "distributionSupplementals": {
    "path": "runtime/distribution-supplementals.json"
  },
  "label": "LÖVE",
  "shortLabel": "LÖVE",
  "gameType": "engine",
  "runtime": {
    "managerUi": {
      "love": {
        "tabLabel": "LÖVE",
        "order": 60,
        "management": "managed",
        "sectionManagement": {
          "luasteam": "built-in"
        }
      }
    },
    "default": "love",
    "supported": [
      "love",
      "native"
    ],
    "entries": {
      "love": {
        "label": "LÖVE",
        "graphicsHost": "window"
      },
      "native": {
        "label": "Native app",
        "graphicsHost": "window"
      }
    },
    "labels": {
      "love": "LÖVE",
      "native": "Native app"
    },
    "manager": {
      "love": "love"
    },
    "inspectorSections": {
      "love": { "exclude": ["luasteam"] }
    },
    "managerSectionBy": {
      "love": "resolvedChannel"
    },
    "managerSectionOverrideKey": {
      "love": "channel"
    },
    "managerSectionMap": {
      "love": {
        "stable": "stable",
        "nightly": "nightly"
      }
    },
    "preLaunch": {
      "love": {
        "statusAction": "runtimeStatus",
        "readyWhen": {
          "key": "ready",
          "equals": true
        },
        "fixAction": "installRuntime",
        "declineAction": "suppressRuntimePrompt",
        "prompt": "This game needs a compatible LÖVE runtime before it can launch. Install it now?"
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "love"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.detectedVersion",
        "label": "LÖVE version",
        "empty": "Unknown"
      },
      {
        "key": "moduleData.appImageReady",
        "label": "AppImage extracted",
        "format": "boolean",
        "hiddenWhen": [
          {
            "key": "moduleData.sourceKind",
            "notEquals": "appimage"
          }
        ]
      },
      {
        "key": "moduleData.appImageExtractedAt",
        "label": "AppImage extracted at",
        "format": "date",
        "hiddenWhen": [
          {
            "key": "moduleData.sourceKind",
            "notEquals": "appimage"
          }
        ]
      },
      {
        "key": "moduleData.appImageExtractRoot",
        "label": "AppImage cache",
        "format": "path",
        "hiddenWhen": [
          {
            "key": "moduleData.sourceKind",
            "notEquals": "appimage"
          }
        ]
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "LÖVE",
      "url": "https://github.com/love2d/love"
    },
    {
      "label": "LuaSteam",
      "url": "https://github.com/uspgamedev/luasteam"
    },
    {
      "label": "LuaJIT (Lua C API headers)",
      "url": "https://luajit.org/"
    }
  ]
}
