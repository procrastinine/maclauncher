{
  "id": "siglus",
  "icon": {
    "path": "resources/icon.png",
    "kind": "symbol"
  },
  "label": "Siglus / RealLive",
  "shortLabel": "Siglus / RealLive",
  "family": "visual-novel",
  "gameType": "scripted",
  "detection": {
    "inputKinds": [
      "file",
      "directory"
    ],
    "fileExtensions": [
      ".exe",
      ".ini",
      ".dat",
      ".pck",
      ".txt"
    ],
    "rootMarkers": [
      "Scene.pck",
      "Gameexe.ini",
      "Seen.txt",
      "Gameexe.dat"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".ini",
      ".pck"
    ]
  },
  "runtime": {
    "default": "siglus",
    "supported": [
      "siglus",
      "rlvm"
    ],
    "manager": {
      "siglus": "siglus",
      "rlvm": "rlvm"
    },
    "managerUi": {
      "siglus-ssu": { "groupId": "siglus", "tabLabel": "Siglus", "sectionLabel": "Siglus SceneScript Utility", "order": 155, "memberOrder": 10, "management": "managed" },
      "rldev": { "groupId": "rlvm", "tabLabel": "RealLive (RLVM)", "sectionLabel": "RLdev", "order": 156, "memberOrder": 20, "management": "managed" },
      "siglus": {
        "tabLabel": "Siglus", "sectionLabel": "Siglus",
        "order": 155,
        "management": "managed"
      },
      "rlvm": {
        "tabLabel": "RealLive (RLVM)", "sectionLabel": "RealLive (RLVM)",
        "order": 156,
        "management": "managed"
      },
      "rlvm-adapter": {
        "groupId": "rlvm",
        "tabLabel": "RealLive (RLVM)",
        "sectionLabel": "MacLauncher adapter",
        "order": 156,
        "memberOrder": 10,
        "management": "managed"
      }
    },
    "entries": {
      "siglus": {
        "graphicsHost": "window",
        "label": "Siglus",
        "settings": {
          "defaults": {
            "encoding": "auto",
            "stringEncryption": "automatic"
          },
          "fields": [
            {
              "key": "encoding",
              "type": "select",
              "label": "Text encoding",
              "description": "siglus_rs runs supported Siglus, RealLive and AVG32 formats. Automatic uses RealLive's encoding metadata; unsupported script revisions stop before launch.",
              "options": [
                {
                  "value": "auto",
                  "label": "Automatic"
                },
                {
                  "value": "sjis",
                  "label": "Japanese"
                },
                {
                  "value": "utf8",
                  "label": "UTF-8"
                },
                {
                  "value": "western",
                  "label": "Windows-1252"
                },
                {
                  "value": "gbk",
                  "label": "Simplified Chinese"
                },
                {
                  "value": "big5",
                  "label": "Traditional Chinese"
                },
                {
                  "value": "korean",
                  "label": "Korean"
                }
              ]
            },
            {
              "key": "stringEncryption",
              "type": "select",
              "label": "Siglus strings",
              "options": [
                {
                  "value": "automatic",
                  "label": "Automatic"
                },
                {
                  "value": "xor",
                  "label": "XOR"
                },
                {
                  "value": "none",
                  "label": "Plain"
                },
                {
                  "value": "mdl",
                  "label": "Detect historical encoding"
                }
              ]
            }
          ]
        }
      },
      "rlvm": {
        "graphicsHost": "window",
        "label": "RealLive (RLVM)"
      }
    }
  },
  "settingsDefaults": {
    "defaultRuntime": "siglus"
  },
  "supports": {
    "saveLocation": true,
    "saveEditing": false,
    "cheats": false,
    "cheatsPatcher": false
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.engineLabel",
        "label": "Format"
      },
      {
        "key": "moduleData.scriptVersion",
        "label": "Script compiler"
      }
    ],
    "actions": [
      {
        "id": "decompile",
        "label": "Decompile",
        "kind": "primary",
        "cancellable": true,
        "hiddenWhen": [{ "key": "moduleData.engineKind", "equals": "avg32" }],
        "resultFields": [
          { "key": "outputDir", "label": "Source", "format": "path" },
          { "key": "scriptCount", "label": "Scripts" },
          { "key": "toolVersion", "label": "Tool version" },
          { "key": "failedFileCount", "label": "Failed scripts" }
        ]
      },
      {
        "id": "revealSource",
        "label": "Reveal source",
        "kind": "secondary",
        "hiddenWhen": [{ "key": "moduleData.sourceExportDir", "falsy": true }]
      },
      {
        "id": "inspectGame",
        "label": "Inspect scripts",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "engineLabel",
            "label": "Format"
          },
          {
            "key": "detectedVersion",
            "label": "Original engine"
          },
          {
            "key": "scriptVersion",
            "label": "Script compiler"
          },
          {
            "key": "scenarios",
            "label": "Scenes"
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "source",
        "label": "Source",
        "actions": ["decompile", "revealSource"]
      },
      {
        "id": "advanced",
        "label": "Advanced",
        "collapsed": true,
        "actions": [
          "inspectGame"
        ]
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "RLdev Go and original RLdev/KFN notices",
      "url": "https://github.com/yoremi-trad-fr/rldev2026-go-edition"
    },
    {
      "label": "Siglus SceneScript Utility (Unlicense OR 0BSD)",
      "url": "https://github.com/Jirehlov/SiglusSceneScriptUtility"
    },
    {
      "label": "siglus_rs (MPL-2.0)",
      "url": "https://github.com/xmoezzz/siglus_rs"
    },
    {
      "label": "RLVM (GPL-3.0-or-later)",
      "url": "https://github.com/eglaysher/rlvm"
    }
  ]
}
