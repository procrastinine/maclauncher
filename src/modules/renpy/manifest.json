{
  "id": "renpy",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "extensions": [
      {
        "extension": ".py",
        "exclusive": true
      },
      {
        "extension": ".sh",
        "exclusive": true
      }
    ],
    "fileExtensions": [
      ".py",
      ".sh",
      ".exe",
      ".rpy",
      ".rpyc",
      ".rpa",
      ".rpyb"
    ],
    "rootMarkers": [
      "renpy",
      "game",
      "Contents/Resources/autorun"
    ],
    "rootExtensions": [
      ".rpy",
      ".rpyc",
      ".rpa",
      ".rpyb"
    ]
  },
  "family": "scripted",
  "label": "Ren'Py",
  "shortLabel": "Ren'Py",
  "gameType": "scripted",
  "runtime": {
    "managerUi": {
      "sdk": {
        "tabLabel": "Ren'Py",
        "order": 30,
        "management": "managed"
      }
    },
    "default": "sdk",
    "supported": [
      "patched",
      "sdk",
      "native"
    ],
    "entries": {
      "patched": {
        "label": "Ren'Py Patch"
      },
      "sdk": {
        "label": "Ren'Py SDK"
      },
      "native": {
        "label": "Native app"
      }
    },
    "labels": {
      "patched": "Ren'Py Patch",
      "sdk": "Ren'Py SDK",
      "native": "Native app"
    },
    "manager": {
      "sdk": "sdk"
    },
    "managerSectionBy": {
      "sdk": "major"
    },
    "managerSectionOverrideKey": {
      "sdk": "major"
    },
    "managerSectionMap": {
      "sdk": {
        "7": "v7",
        "8": "v8"
      }
    },
    "preLaunch": {
      "patched": {
        "statusAction": "patchStatus",
        "readyWhen": {
          "key": "patched",
          "equals": true
        },
        "fixAction": "patch",
        "prompt": "This game needs the Ren'Py patch before it can launch. Patch now?"
      }
    }
  },
  "supports": {
    "cheats": true,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": true
  },
  "settingsDefaults": {
    "defaultRuntime": "sdk"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.version",
        "label": "Runtime version",
        "hiddenWhen": [
          {
            "key": "runtimeId",
            "equals": "sdk"
          },
          {
            "key": "runtimeId",
            "equals": "patched"
          }
        ]
      }
    ],
    "cheatsStatusAction": "renpyCheatsStatus",
    "cheatsPatches": [
      {
        "id": "renpyConsole",
        "label": "Ren'Py console (Shift+O)",
        "statusKey": "consolePresent",
        "addAction": "installRenpyConsole",
        "removeAction": "removeRenpyConsole"
      },
      {
        "id": "renpyWalkthrough",
        "label": "Universal Ren'Py Walkthrough System",
        "statusKey": "urwPresent",
        "addAction": "patchRenpyWalkthrough",
        "removeAction": "removeRenpyWalkthrough"
      },
      {
        "id": "renpyMod",
        "label": "Universal Ren'Py Mod",
        "statusKey": "urmPresent",
        "addAction": "addRenpyMod",
        "removeAction": "removeRenpyMod"
      }
    ],
    "cheatsMode": "patches",
    "actions": [
      {
        "id": "inspectSaveMetadata",
        "label": "Inspect save metadata",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "count",
            "label": "Save files"
          },
          {
            "key": "validCount",
            "label": "Readable metadata"
          }
        ]
      },
      {
        "id": "revealSaveMetadata",
        "label": "Reveal metadata report",
        "kind": "secondary",
        "disabledWhen": [
          {
            "key": "moduleData.saveMetadataReportPath",
            "falsy": true
          }
        ]
      },
      {
        "id": "installRenpyConsole",
        "label": "Enable Ren'Py console (Shift+O)",
        "kind": "primary",
        "confirm": "Add a Ren'Py script that enables the in-game Python console? Restart the game after installing."
      },
      {
        "id": "removeRenpyConsole",
        "label": "Remove Ren'Py console patch",
        "kind": "danger"
      },
      {
        "id": "renpyCheatsStatus",
        "label": "Refresh Ren'Py cheats",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true
      },
      {
        "id": "patchRenpyWalkthrough",
        "label": "Patch Universal Ren'Py Walkthrough System",
        "kind": "primary"
      },
      {
        "id": "removeRenpyWalkthrough",
        "label": "Remove Universal Ren'Py Walkthrough System",
        "kind": "danger"
      },
      {
        "id": "addRenpyMod",
        "label": "Add Universal Ren'Py Mod",
        "kind": "primary"
      },
      {
        "id": "removeRenpyMod",
        "label": "Remove Universal Ren'Py Mod",
        "kind": "danger"
      },
      {
        "id": "patchStatus",
        "label": "Refresh Ren'Py patch status",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "renpyVersion",
            "label": "Ren'Py"
          },
          {
            "key": "patchStatusLabel",
            "label": "Status"
          }
        ]
      },
      {
        "id": "patch",
        "label": "Patch",
        "kind": "primary",
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          },
          {
            "key": "moduleData.patched",
            "equals": true
          }
        ]
      },
      {
        "id": "unpatch",
        "label": "Remove Ren'Py patch",
        "kind": "danger",
        "icon": "x",
        "iconOnly": true,
        "confirm": "Remove Ren'Py runtime patches from this game?",
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          }
        ]
      },
      {
        "id": "buildApp",
        "label": "Build app bundle",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "lastBuiltAt",
            "truthy": true
          }
        ],
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          },
          {
            "key": "gamePath",
            "endsWith": ".app"
          }
        ]
      },
      {
        "id": "refreshBuild",
        "label": "Reload",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          }
        ]
      },
      {
        "id": "revealBuild",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          },
          {
            "key": "lastBuiltAt",
            "falsy": true
          }
        ]
      },
      {
        "id": "deleteBuild",
        "label": "Remove app bundle",
        "kind": "danger",
        "confirm": "Remove the latest built app bundle?",
        "hiddenWhen": [
          {
            "key": "lastBuiltAt",
            "falsy": true
          }
        ],
        "disabledWhen": [
          {
            "key": "moduleData.gameOnly",
            "equals": true
          }
        ]
      },
      {
        "id": "refreshExtractionStatus",
        "label": "Reload",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "extractStatusLabel",
            "label": "Status"
          },
          {
            "key": "extractedAt",
            "label": "Last extract",
            "format": "date"
          }
        ]
      },
      {
        "id": "revealExtraction",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "extractGame",
        "label": "Extract",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "truthy": true
          }
        ]
      },
      {
        "id": "removeExtraction",
        "label": "Remove Extracted",
        "kind": "danger",
        "confirm": "Remove extracted Ren'Py files?",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "live2DStatus",
        "label": "Live2D status",
        "kind": "secondary",
        "autoRun": true,
        "resultFields": [
          {
            "key": "version",
            "label": "Core version"
          },
          {
            "key": "apiProfile",
            "label": "API"
          },
          {
            "key": "reason",
            "label": "Status"
          }
        ]
      },
      {
        "id": "patchLive2D",
        "label": "Install Live2D library",
        "kind": "primary",
        "confirm": "Install the compatible Live2D Core library in this game’s macOS runtime? An existing library is backed up."
      },
      {
        "id": "removeLive2D",
        "label": "Remove Live2D library",
        "kind": "danger",
        "confirm": "Remove the launcher-installed Live2D library and restore the original library, if one was backed up?"
      }
    ],
    "actionGroups": [
      {
        "id": "saveMetadata",
        "label": "Save metadata",
        "actions": [
          "inspectSaveMetadata",
          "revealSaveMetadata"
        ],
        "note": "ZIP/JSON metadata only. Save editing is unavailable."
      },
      {
        "id": "patching",
        "label": "Ren'Py Patching",
        "actions": [
          "patchStatus",
          "patch",
          "unpatch"
        ],
        "hiddenWhen": [
          {
            "key": "gamePath",
            "endsWith": ".app"
          }
        ]
      },
      {
        "id": "builds",
        "label": "Builds",
        "actions": [
          "refreshBuild",
          "revealBuild",
          "buildApp",
          "deleteBuild"
        ],
        "note": "Builds are stored in the launcher data folder.",
        "hiddenWhen": [
          {
            "key": "gamePath",
            "endsWith": ".app"
          }
        ]
      },
      {
        "id": "extract",
        "label": "Extract",
        "actions": [
          "refreshExtractionStatus",
          "revealExtraction",
          "extractGame",
          "removeExtraction"
        ],
        "note": "Extracted files are stored in the launcher data folder."
      },
      {
        "id": "libraries",
        "label": "Libraries",
        "actions": [
          "live2DStatus",
          "patchLive2D",
          "removeLive2D"
        ],
        "note": "SDK libraries are managed per version in Runtimes. These actions change this game’s patched macOS runtime.",
        "hiddenWhen": [
          {
            "key": "gamePath",
            "endsWith": ".app"
          }
        ]
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "Ren'Py",
      "url": "https://github.com/renpy/renpy"
    },
    {
      "label": "rpatool",
      "url": "https://codeberg.org/shiz/rpatool"
    },
    {
      "label": "UnRen-Gideon-mod-",
      "url": "https://github.com/VepsrP/UnRen-Gideon-mod-"
    },
    {
      "label": "unrpyc",
      "url": "https://github.com/CensoredUsername/unrpyc"
    },
    {
      "label": "UnRen-forall",
      "url": "https://github.com/Lurmel/UnRen-forall"
    },
    {
      "label": "Universal Ren'Py Walkthrough System",
      "url": "https://github.com/BCassO/universal-renpy-walkthrough"
    },
    {
      "label": "Universal Ren'Py Mod",
      "url": "https://0x52.dev/mods/Universal-Ren-Py-Mod-1000"
    }
  ]
}
