+// Draw original ASS, bitmap subtitles and script overlays to a separate
+// premultiplied sRGB surface. No video shaders, target-PQ conversion, frame
+// counters, interpolation, or decoder uploads run in this path.
+void gl_video_render_osd_layer(struct gl_video *p, struct vo_frame *frame,
+                               const struct ra_fbo *fbo)
+{
+    gl_video_update_options(p);
+    struct mp_rect target = {0, 0, fbo->tex->params.w, fbo->tex->params.h};
+    float transparent[4] = {0};
+    p->ra->fns->clear(p->ra, fbo->tex, transparent, &target);
+    if (!p->osd)
+        return;
+    double pts = frame->current ? frame->current->pts : p->osd_pts;
+    if (pts == MP_NOPTS_VALUE)
+        pts = p->osd_pts;
+    pass_draw_osd(p, 0, RENDER_FRAME_SUBS | RENDER_FRAME_OSD, pts,
+                  p->osd_rect, fbo, false);
+}
