{
  "id": "flash",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "detection": {
    "inputKinds": [
      "file"
    ],
    "extensions": [
      {
        "extension": ".swf",
        "exclusive": true
      }
    ],
    "fileExtensions": [
      ".swf"
    ],
    "fileSignatures": [
      {
        "hex": "465753",
        "minSize": 3
      },
      {
        "hex": "435753",
        "minSize": 3
      },
      {
        "hex": "5a5753",
        "minSize": 3
      }
    ],
    "directoryFileExtensions": [
      ".swf"
    ]
  },
  "family": "scripted",
  "label": "Flash",
  "shortLabel": "Flash",
  "gameType": "scripted",
  "runtime": {
    "managerUi": {
      "flash-projector": {
        "groupId": "flash",
        "tabLabel": "Flash",
        "sectionLabel": "Flash Player",
        "order": 70,
        "memberOrder": 0,
        "management": "managed"
      },
      "ruffle": {
        "groupId": "flash",
        "tabLabel": "Flash",
        "sectionLabel": "Ruffle",
        "order": 70,
        "memberOrder": 1,
        "management": "managed"
      },
      "ffdec": {
        "groupId": "flash",
        "tabLabel": "Flash",
        "sectionLabel": "JPEXS FFDec",
        "order": 70,
        "memberOrder": 2,
        "management": "managed"
      }
    },
    "default": "projector",
    "supported": [
      "projector",
      "ruffle"
    ],
    "entries": {
      "projector": {
        "graphicsHost": "window",
        "label": "Adobe Flash Player"
      },
      "ruffle": {
        "graphicsHost": "window",
        "label": "Ruffle"
      }
    },
    "labels": {
      "projector": "Adobe Flash Player",
      "ruffle": "Ruffle"
    },
    "manager": {
      "projector": "flash-projector",
      "ruffle": "ruffle"
    },
    "preLaunch": {
      "ruffle": {
        "statusAction": "runtimeStatus",
        "readyWhen": {
          "key": "ready",
          "equals": true
        },
        "fixAction": "installRuntime",
        "prompt": "This game needs a Ruffle runtime before it can launch. Install it now?"
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "projector"
  },
  "acknowledgments": [
    {
      "label": "Adobe Flash Player (proprietary)",
      "url": "https://www.adobe.com/products/flashplayer/end-of-life.html"
    },
    {
      "label": "Ruffle",
      "url": "https://github.com/ruffle-rs/ruffle"
    },
    {
      "label": "JPEXS FFDec (GPL-3.0-or-later)",
      "url": "https://github.com/jindrapetrik/jpexs-decompiler"
    }
  ],
  "ui": {
    "actions": [
      {
        "id": "decompile",
        "label": "Export ActionScript",
        "kind": "primary",
        "resultFields": [
          {
            "key": "outputDir",
            "label": "Export",
            "format": "path"
          },
          {
            "key": "toolVersion",
            "label": "JPEXS FFDec"
          }
        ],
        "cancellable": true
      },
      {
        "id": "exportAssets",
        "label": "Export scripts and assets",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "outputDir",
            "label": "Export",
            "format": "path"
          }
        ],
        "cancellable": true
      },
      {
        "id": "revealExport",
        "label": "Reveal export",
        "kind": "secondary",
        "hiddenWhen": [
          {
            "key": "moduleData.ffdecExportDir",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "flash-tools",
        "label": "Flash tools",
        "actions": [
          "decompile",
          "exportAssets",
          "revealExport"
        ],
        "note": "JPEXS FFDec exports ActionScript and resources to separate files. The original SWF is preserved."
      }
    ]
  }
}
