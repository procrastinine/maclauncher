export function graphicsGroup(type: GraphicsType): 'Image filters' | 'Resize' | 'Temporal';
export function catalogGroup(implementation: ContractImplementation & {template:ContractNode}): 'Image filters' | 'Resize' | 'Temporal';
export function extentEditable(implementation?: ContractImplementation): boolean;
