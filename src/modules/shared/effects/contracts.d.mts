export type GraphicsType = 'image' | 'downsample' | 'upscale' | 'temporal' | 'generation';
export type ContractNode = {id?:string;kind: string; method?: string; shader?: {preset?: string}; settings?: object; outputSize?:{width?:number;height?:number};presentationScale?:number;extent?: {relativeTo?: string; factor?: number; automatic?: true;width?:number;height?:number}};
export type ContractImplementation = {template?: ContractNode; available?:boolean;recommendationRank?: number; intrinsicScale?: number; outputContract?: {domain?: string; sizing?: string; direction?: string; resizeDirections?: ('downsample'|'upscale')[]; extentEditable?:boolean; preservesSize?:boolean;compositeTarget?:boolean;scale?: number | {x:number;y:number};resizeContext?:string;scaleRange?:{min:{x:number;y:number};max:{x:number;y:number}}}; traits?: {outputScale?: {x:number;y:number};preservesSize?:boolean;conditionalGeometry?:boolean;displayDependentGeometry?:boolean;unresolvedGeometry?:boolean;geometryKnown?:boolean;authoredResize?:boolean;requestedResize?:boolean;resizeContext?:string;outputScaleRange?:{min:{x:number;y:number};max:{x:number;y:number}};outputSize?:{width?:number;height?:number};outputExtentEditable?:boolean;requestedOutputExtent?:boolean;compositeTarget?:boolean;resizeDirections?:('downsample'|'upscale')[]}};
export const GRAPHICS_TYPES: readonly Readonly<{id:GraphicsType;label:string;input:string;output:string}>[];
export type ShaderGeometry = {kind:'identity'|'scale'|'size'|'conditional'|'target'|'unknown';directions:('downsample'|'upscale')[];scale?:{x:number;y:number};size?:{width?:number;height?:number};range?:{min:{x:number;y:number};max:{x:number;y:number}};target?:'presentation'|'input';refines?:'downsample'|'upscale'};
