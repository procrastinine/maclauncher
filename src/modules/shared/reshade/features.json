{
  "losslessInspection": true,
  "graphics": {
    "sharedFrameEncoder": true,
    "browserFrameAPI": 1,
    "virtualWindowAPI": 1,
    "virtualSourceControlAPI": 1,
    "virtualSourceActivationAPI": 1,
    "virtualSourceAutoAPI": 1,
    "presentationHoldAPI": 1,
    "presentationHoldAbandonAPI": 1,
