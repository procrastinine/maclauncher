          "frameGeneration": true,
          "adaptive": true,
          "liveSwitching": true,
          "temporal": true,
          "temporalMethods": [
            "metalfx",
            "fsr4"
          ],
          "effectPlacement": true
        },
        "remote": {
          "spatial": true,
          "frameGeneration": true,
          "adaptive": true,
          "liveSwitching": true,
          "effectPlacement": true
        },
        "explicit": {
          "spatial": true,
          "frameGeneration": true,
          "resolutionMultipliers": [
            1,
            1.5,
            2
          ],
          "effectPlacement": true
        },
        "catalyst": {
          "spatial": true,
          "frameGeneration": true,
          "resolutionMultipliers": [
            1,
            1.5,
            2
          ],
          "adaptive": true,
          "liveSwitching": true,
          "temporal": true,
          "temporalMethods": [
            "metalfx",
            "fsr4"
          ],
          "effectPlacement": true
        }
      },
      "effectPlacement": true
    },
    "temporalMethods": [
      "metalfx",
      "fsr2",
      "fsr3",
      "fsr4"
    ],
    "temporalFrameAPI": 1,
    "temporalCameraAPI": 1,
    "effectPlanAPI": 1,
    "effectPlanKinds": [
      "shader",
      "spatial",
      "frame-generation",
