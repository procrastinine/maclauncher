// Structure tensor, separable Gaussian, eigenframe and original eight-sector AKF v2.
//!PARAM Radius
//!DESC Radius
//!TYPE float
//!MINIMUM 1
//!MAXIMUM 20
3
//!PARAM Sharpness
//!DESC Sharpness
//!TYPE float
//!MINIMUM 1
//!MAXIMUM 16
8
//!PARAM Anisotropy
//!DESC Anisotropy
//!TYPE float
//!MINIMUM 0
//!MAXIMUM 4
1
//!PARAM Smoothing
//!DESC Orientation smoothing
//!TYPE float
//!MINIMUM 0
//!MAXIMUM 5
2

//!TEXTURE AKF_KERNEL
//!SIZE 34 34
//!FORMAT rgba16f
//!FILTER LINEAR
//!BORDER CLAMP


//!HOOK MAIN
//!DESC Anisotropic Kuwahara structure tensor
//!BIND HOOKED
//!SAVE AKF_TENSOR
//!COMPONENTS 4
vec4 mlSource(vec2 p){vec4 c=HOOKED_tex(p);return vec4(c.a>0.0?c.rgb/c.a:vec3(0.0),c.a);}
vec4 hook(){
    vec2 src_size = HOOKED_size;
    vec2 uv = HOOKED_pos * HOOKED_size / src_size;
    vec2 d = 1.0 / src_size;

    vec3 c = mlSource( uv).xyz;
    vec3 u = (
           -1.0 * mlSource( uv + vec2(-d.x, -d.y)).xyz +
           -2.0 * mlSource( uv + vec2(-d.x,  0.0)).xyz + 
           -1.0 * mlSource( uv + vec2(-d.x,  d.y)).xyz +
           +1.0 * mlSource( uv + vec2( d.x, -d.y)).xyz +
           +2.0 * mlSource( uv + vec2( d.x,  0.0)).xyz + 
           +1.0 * mlSource( uv + vec2( d.x,  d.y)).xyz
           ) / 4.0;

    vec3 v = (
           -1.0 * mlSource( uv + vec2(-d.x, -d.y)).xyz + 
           -2.0 * mlSource( uv + vec2( 0.0, -d.y)).xyz + 
           -1.0 * mlSource( uv + vec2( d.x, -d.y)).xyz +
           +1.0 * mlSource( uv + vec2(-d.x,  d.y)).xyz +
           +2.0 * mlSource( uv + vec2( 0.0,  d.y)).xyz + 
           +1.0 * mlSource( uv + vec2( d.x,  d.y)).xyz
           ) / 4.0;

    return vec4(dot(u, u), dot(v, v), dot(u, v), 1.0);
}

//!HOOK MAIN
//!DESC Anisotropic Kuwahara tensor smoothing
//!BIND AKF_TENSOR
//!SAVE AKF_SMOOTH_X
//!COMPONENTS 4
vec4 hook(){float sigma=Smoothing;int halfWidth=int(ceil(2.0*sigma));vec3 sum=vec3(0.0);float norm=0.0;
 if(halfWidth==0)return AKF_TENSOR_tex(AKF_TENSOR_pos);
 for(int i=-halfWidth;i<=halfWidth;i++){float w=exp(-float(i*i)/(2.0*sigma*sigma));sum+=AKF_TENSOR_tex(AKF_TENSOR_pos+vec2(AKF_TENSOR_pt.x,0.0)*float(i)).rgb*w;norm+=w;}
 return vec4(sum/norm,1.0);}

//!HOOK MAIN
//!DESC Anisotropic Kuwahara tensor smoothing
//!BIND AKF_SMOOTH_X
//!SAVE AKF_SMOOTH_Y
//!COMPONENTS 4
vec4 hook(){float sigma=Smoothing;int halfWidth=int(ceil(2.0*sigma));vec3 sum=vec3(0.0);float norm=0.0;
 if(halfWidth==0)return AKF_SMOOTH_X_tex(AKF_SMOOTH_X_pos);
 for(int i=-halfWidth;i<=halfWidth;i++){float w=exp(-float(i*i)/(2.0*sigma*sigma));sum+=AKF_SMOOTH_X_tex(AKF_SMOOTH_X_pos+vec2(0.0,AKF_SMOOTH_X_pt.y)*float(i)).rgb*w;norm+=w;}
 return vec4(sum/norm,1.0);}

//!HOOK MAIN
//!DESC Anisotropic Kuwahara orientation
//!BIND AKF_SMOOTH_Y
//!SAVE AKF_ORIENTATION
//!COMPONENTS 4
vec4 hook(){
    vec2 uv = AKF_SMOOTH_Y_pos;
    vec3 g = AKF_SMOOTH_Y_tex( uv).xyz;

    float lambda1 = 0.5 * (g.y + g.x +
        sqrt(g.y*g.y - 2.0*g.x*g.y + g.x*g.x + 4.0*g.z*g.z));
    float lambda2 = 0.5 * (g.y + g.x -
        sqrt(g.y*g.y - 2.0*g.x*g.y + g.x*g.x + 4.0*g.z*g.z));

    vec2 v = vec2(lambda1 - g.x, -g.z);
    vec2 t;
    if (length(v) > 0.0) { 
        t = normalize(v);
    } else {
        t = vec2(0.0, 1.0);
    }

    float phi = atan(t.y, t.x);

    float A = (lambda1 + lambda2 > 0.0)?
        (lambda1 - lambda2) / (lambda1 + lambda2) : 0.0;

    return vec4(t, phi, A);
}

//!HOOK MAIN
//!DESC Anisotropic Kuwahara
//!BIND HOOKED
//!BIND AKF_ORIENTATION
//!BIND AKF_KERNEL
vec4 mlSource(vec2 p){vec4 c=HOOKED_tex(p);return vec4(c.a>0.0?c.rgb/c.a:vec3(0.0),c.a);}
vec4 mlKernel(vec2 p){return AKF_KERNEL_tex((p*32.0+1.0)/34.0);}
const float PI=3.14159265358979323846;const int N=8;
vec4 hook(){
    vec2 src_size = HOOKED_size;
    vec2 uv = HOOKED_pos * HOOKED_size / src_size;

    vec4 m[8];
    vec3 s[8];
    for (int k = 0; k < N; ++k) {
        m[k] = vec4(0.0);
        s[k] = vec3(0.0);
    }

    vec4 t = AKF_ORIENTATION_tex( uv);
    t.w *= Anisotropy;
    float a = Radius * clamp((1.0 + t.w) / 1.0, 0.1, 2.0); 
    float b = Radius * clamp(1.0 / (1.0 + t.w), 0.1, 2.0);

    float cos_phi = cos(t.z);
    float sin_phi = sin(t.z);

    mat2 R = mat2(cos_phi, -sin_phi, sin_phi, cos_phi);
    mat2 S = mat2(0.5/a, 0.0, 0.0, 0.5/b);
    mat2 SR = S * R;

    int max_x = int(sqrt(a*a * cos_phi*cos_phi +
                          b*b * sin_phi*sin_phi));
    int max_y = int(sqrt(a*a * sin_phi*sin_phi +
                          b*b * cos_phi*cos_phi));

    {
        vec3 c = mlSource( uv).rgb;
        float w = mlKernel( vec2(0.5, 0.5)).x;
        for (int k = 0; k < N; ++k) {
            m[k] +=  vec4(c * w, w);
            s[k] += c * c * w;
        }
    }

    for (int j = 0; j <= max_y; ++j)  {
        for (int i = -max_x; i <= max_x; ++i) {
            if ((j !=0) || (i > 0)) {
                vec2 v = SR * vec2(i,j);

                if (dot(v,v) <= 0.25) {
                    vec3 c0 = mlSource(uv + vec2(i,j)/src_size).rgb;
                    vec3 c1 = mlSource(uv - vec2(i,j)/src_size).rgb;

                    vec3 cc0 = c0 * c0;
                    vec3 cc1 = c1 * c1;

                    vec4 w0123 = mlKernel( vec2(0.5, 0.5) + v);
                    for (int k = 0; k < 4; ++k) {
                        m[k] += vec4(c0 * w0123[k], w0123[k]);
                        s[k] += cc0 * w0123[k];
                    }
                    for (int k = 4; k < 8; ++k) {
                        m[k] += vec4(c1 * w0123[k-4], w0123[k-4]);
                        s[k] += cc1 * w0123[k-4];
                    }

                    vec4 w4567 = mlKernel( vec2(0.5, 0.5) - v);
                    for (int k = 4; k < 8; ++k) {
                        m[k] += vec4(c0 * w4567[k-4], w4567[k-4]);
                        s[k] += cc0 * w4567[k-4];
                    }
                    for (int k = 0; k < 4; ++k) {
                        m[k] += vec4(c1 * w4567[k], w4567[k]);
                        s[k] += cc1 * w4567[k];
                    }
                }
            }
        }
    }

    float logWeights[8];
    float maximumLogWeight = -3.402823e38;
    for (int k = 0; k < N; ++k) {
        m[k].rgb /= m[k].w;
        s[k] = abs(s[k] / m[k].w - m[k].rgb * m[k].rgb);
        float sigma2 = s[k].r + s[k].g + s[k].b;
        float exponent = 0.5 * Sharpness * log(max(255.0 * sigma2, 1e-30));
        logWeights[k] = -max(exponent, 0.0) - log(1.0 + exp(-abs(exponent)));
        maximumLogWeight = max(maximumLogWeight, logWeights[k]);
    }
    vec4 o = vec4(0.0);
    for (int k = 0; k < N; ++k) {
        float w = exp(logWeights[k] - maximumLogWeight);
        o += vec4(m[k].rgb * w, w);
    }

    vec4 original = HOOKED_tex(HOOKED_pos);
    return vec4((o.rgb / o.w) * original.a, original.a);
}
