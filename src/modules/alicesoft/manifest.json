{
  "id": "alicesoft",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "family": "scripted",
  "label": "AliceSoft",
  "shortLabel": "AliceSoft",
  "gameType": "scripted",
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "fileExtensions": [
      ".exe",
      ".ald",
      ".dat",
      ".ini",
      ".ain"
    ],
    "rootMarkers": [
      "ADISK.DAT",
      "Contents/Resources/game",
      "Contents/Resources",
      "System40.ini"
    ],
    "rootExtensions": [
      ".ald"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".ald"
    ]
  },
  "runtime": {
    "managerUi": {
      "alice-tools": { "groupId": "alicesoft", "tabLabel": "AliceSoft", "sectionLabel": "Alice tools", "order": 110, "memberOrder": 5, "management": "managed" },
      "system3": {
        "groupId": "alicesoft",
        "tabLabel": "AliceSoft",
        "order": 110,
        "sectionLabel": "System 1–3",
        "memberOrder": 0,
        "management": "managed"
      },
      "xsystem35": {
        "groupId": "alicesoft",
        "tabLabel": "AliceSoft",
        "order": 110,
        "sectionLabel": "System 3.5–3.9",
        "memberOrder": 1,
        "management": "managed"
      },
      "xsystem4": {
        "groupId": "alicesoft",
        "tabLabel": "AliceSoft",
        "order": 110,
        "sectionLabel": "System 4",
        "memberOrder": 2,
        "management": "managed"
      },
      "sys3-decompiler": {
        "groupId": "alicesoft",
        "tabLabel": "AliceSoft",
        "order": 110,
        "sectionLabel": "System1–3 source",
        "memberOrder": 3,
        "management": "managed"
      },
      "xsys35-decompiler": {
        "groupId": "alicesoft",
        "tabLabel": "AliceSoft",
        "order": 110,
        "sectionLabel": "System3.x source",
        "memberOrder": 4,
        "management": "managed"
      }
    },
    "default": "system3",
    "supported": [
      "system3",
      "xsystem35",
      "xsystem4"
    ],
    "manager": {
      "system3": "system3",
      "xsystem35": "xsystem35",
      "xsystem4": "xsystem4"
    },
    "entries": {
      "system3": {
        "graphicsHost": "window",
        "label": "System 1–3",
        "settings": {
          "defaults": {
            "version": "auto",
            "fontPath": "",
            "gameId": "",
            "textHook": "none",
            "fullscreen": false
          },
          "fields": [
            {
              "key": "version",
              "type": "select",
              "label": "Version to register",
              "options": [
                {
                  "value": "auto",
                  "label": "Current selection"
                }
              ],
              "optionsAction": "listRuntimeVersions",
              "optionsKey": "runtimeVersions"
            },
            {
              "key": "fontPath",
              "type": "string",
              "label": "Font override",
              "description": "Optional local TTF/OTF. Bundled runtimes provide a default font automatically."
            },
            {
              "key": "gameId",
              "type": "string",
              "label": "Game ID override",
              "description": "Use the upstream game ID for translated or modified games."
            },
            {
              "key": "textHook",
              "type": "select",
              "label": "Text capture",
              "options": [
                {
                  "value": "none",
                  "label": "Off"
                },
                {
                  "value": "print",
                  "label": "Console"
                },
                {
                  "value": "copy",
                  "label": "Clipboard"
                }
              ]
            },
            {
              "key": "fullscreen",
              "type": "boolean",
              "label": "Start fullscreen"
            }
          ]
        }
      },
      "xsystem35": {
        "graphicsHost": "window",
        "label": "System 3.5–3.9",
        "settings": {
          "defaults": {
            "version": "auto",
            "fontPath": "",
            "gameId": "",
            "textHook": "none",
            "fullscreen": false
          },
          "fields": [
            {
              "key": "version",
              "type": "select",
              "label": "Version to register",
              "options": [
                {
                  "value": "auto",
                  "label": "Current selection"
                }
              ],
              "optionsAction": "listRuntimeVersions",
              "optionsKey": "runtimeVersions"
            },
            {
              "key": "fontPath",
              "type": "string",
              "label": "Font override",
              "description": "Optional local TTF/OTF for both text styles. Bundled runtimes provide gothic and mincho fonts automatically."
            },
            {
              "key": "gameId",
              "type": "string",
              "label": "Game ID override",
              "description": "Use the upstream game ID for translated or modified games."
            },
            {
              "key": "textHook",
              "type": "select",
              "label": "Text capture",
              "options": [
                {
                  "value": "none",
                  "label": "Off"
                },
                {
                  "value": "print",
                  "label": "Console"
                },
                {
                  "value": "copy",
                  "label": "Clipboard"
                }
              ]
            },
            {
              "key": "fullscreen",
              "type": "boolean",
              "label": "Start fullscreen"
            }
          ]
        }
      },
      "xsystem4": {
        "graphicsHost": "window",
        "label": "System 4",
        "settings": {
          "defaults": {
            "version": "auto",
            "fontPath": "",
            "textHook": "none"
          },
          "fields": [
            {
              "key": "version",
              "type": "select",
              "label": "Version to register",
              "options": [
                {
                  "value": "auto",
                  "label": "Current selection"
                }
              ],
              "optionsAction": "listRuntimeVersions",
              "optionsKey": "runtimeVersions"
            },
            {
              "key": "fontPath",
              "type": "string",
              "label": "Font override",
              "description": "Optional local TTF/OTF for both text styles. Bundled runtimes provide gothic and mincho fonts automatically."
            },
            {
              "key": "textHook",
              "type": "select",
              "label": "Text capture",
              "options": [
                {
                  "value": "none",
                  "label": "Off"
                },
                {
                  "value": "print",
                  "label": "Console"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": true
  },
  "settingsDefaults": {
    "defaultRuntime": "system3"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.detectedVersion",
        "label": "Detected engine version"
      },
      {
        "key": "moduleData.generation",
        "label": "Engine family"
      },
      {
        "key": "moduleData.detectedVersionConfidence",
        "label": "Version confidence"
      },
      {
        "key": "moduleData.detectedVersionSource",
        "label": "Version evidence"
      },
      {
        "key": "moduleData.scenarioFormat",
        "label": "Scenario format"
      },
      {
        "key": "moduleData.ainVersion",
        "label": "AIN format version"
      },
      {
        "key": "moduleData.detectedGameId",
        "label": "Detected game ID"
      },
      {
        "key": "moduleData.compatibility",
        "label": "Compatibility"
      }
    ],
    "actions": [
      {
        "id": "openLiveVariables",
        "label": "Live variables",
        "kind": "primary"
      },
      {
        "id": "decompile",
        "label": "Decompile",
        "kind": "primary",
        "cancellable": true,
        "resultFields": [
          {
            "key": "outputDir",
            "label": "Export",
            "format": "path"
          }
        ]
      },
      {
        "id": "revealSourceExport",
        "label": "Reveal export",
        "kind": "secondary",
        "disabledWhen": [
          {
            "key": "moduleData.sourceExportDir",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "live",
        "label": "Live",
        "actions": [
          "openLiveVariables"
        ]
      },
      {
        "id": "source",
        "label": "Source",
        "actions": [
          "decompile",
          "revealSourceExport"
        ]
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "Alice tools (GPL-2.0)",
      "url": "https://github.com/nunuhara/alice-tools"
    },
    {
      "label": "System3 SDL2",
      "url": "https://github.com/kichikuou/system3-sdl2"
    },
    {
      "label": "xsystem35 SDL2",
      "url": "https://github.com/kichikuou/xsystem35-sdl2"
    },
    {
      "label": "xsystem4",
      "url": "https://github.com/nunuhara/xsystem4"
    },
    {
      "label": "libsys4 (GPL-2.0-or-later)",
      "url": "https://github.com/nunuhara/libsys4"
    },
    {
      "label": "sys3c (GPL-2.0-or-later)",
      "url": "https://github.com/kichikuou/sys3c"
    },
    {
      "label": "xsys35c (GPL-2.0-or-later)",
      "url": "https://github.com/kichikuou/xsys35c"
    }
  ]
}
