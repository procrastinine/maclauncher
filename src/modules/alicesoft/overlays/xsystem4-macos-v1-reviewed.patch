diff --git a/src/video.c b/src/video.c
--- a/src/video.c
+++ b/src/video.c
@@ -40,7 +40,7 @@
 	"precision highp float;\n"
 	"precision highp int;\n";
 #else
-	"#version 140\n";
+	"#version 150\n";
 #endif
 
 /*
@@ -74,7 +74,16 @@
 
 static GLchar *read_shader_file(const char *path)
 {
-	GLchar *source = SDL_LoadFile(path, NULL);
+	// Prefer the runtime's own shader assets over similarly named game files.
+	char portable_path[PATH_MAX];
+	char *base_path = SDL_GetBasePath();
+	GLchar *source = NULL;
+	if (base_path) {
+		snprintf(portable_path, PATH_MAX, "%s../share/xsystem4/%s", base_path, path);
+		source = SDL_LoadFile(portable_path, NULL);
+		SDL_free(base_path);
+	}
+	if (!source) source = SDL_LoadFile(path, NULL);
 	if (!source) {
 		char full_path[PATH_MAX];
 		snprintf(full_path, PATH_MAX, XSYS4_DATA_DIR "/%s", path);
@@ -238,7 +247,7 @@
 	SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
 #else
 	SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
-	SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);
+	SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 2);
 	SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
 #endif
 
