+++ b/src/ui/scriptspritemenu.cpp
@@ -0,0 +1,109 @@
+#include "scriptspritemenu.h"
+#include "ui.h"
+#include "../profile/ui/titlemenu.h"
+#include "../profile/scriptvars.h"
+#include "../mem.h"
+#include "../inputsystem.h"
+#include "../vm/interface/input.h"
+#include "../renderer/renderer.h"
+#include "../log.h"
+#include "../video/videosystem.h"
+
+namespace Impacto::UI {
+using namespace Profile::ScriptVars;
+using namespace Vm::Interface;
+
+ScriptSpriteMenu::ScriptSpriteMenu(Sprite background, glm::vec2 backgroundPos,
+                                 std::vector<glm::vec2> positions,
+                                 std::vector<int> ids)
+    : Background(background), BackgroundPos(backgroundPos),
+      Positions(std::move(positions)), Ids(std::move(ids)) {
+  if (Positions.size() != Ids.size() || Ids.empty() ||
+      Ids.size() != static_cast<size_t>(Profile::TitleMenu::MenuEntriesNum))
+    throw std::runtime_error("Invalid script sprite menu entries");
+}
+void ScriptSpriteMenu::Init() {
+  Cursor = 0;
+  ChoiceMade = false;
+  State = Hidden;
+  IsFocused = false;
+  ScrWork[SW_TITLEMODE] = 0;
+  ScrWork[SW_TITLEMOVIECT] = 0;
+  ScrWork[SW_TITLEDISPCT] = 0;
+  SetFlag(SF_TITLEEND, 0);
+}
+void ScriptSpriteMenu::SetEnabled(bool enabled) {
+  Enabled = enabled;
+  State = enabled ? Shown : Hidden;
+  IsFocused = enabled;
+  if (enabled) UI::FocusedMenu = this;
+  else if (UI::FocusedMenu == this) UI::FocusedMenu = nullptr;
+}
+void ScriptSpriteMenu::Tick(float dt) {
+  const int mode = ScrWork[SW_TITLEMODE];
+  const int flag = GetFlag(SF_TITLEMODE);
+  if (LastMode != mode || LastFlag != flag) {
+    ImpLog(LogLevel::Info, LogChannel::VM,
+           "Script title state: mode {} active {} cursor {} display {}\n",
+           mode, flag, ScrWork[SW_TITLECUR1], ScrWork[SW_TITLEDISPCT]);
+    LastMode = mode;
+    LastFlag = flag;
+  }
+  if (!flag || mode == 0) {
+    State = Hidden;
+    return;
+  }
+  SetEnabled(true);
+  State = Shown;
+  const bool confirm = (PADinputButtonWentDown & PAD1A) ||
+      Input::MouseButtonWentDown[SDL_BUTTON_LEFT];
+  if (mode == 1) {
+    if (confirm) {
+      ScrWork[SW_TITLEMODE] = 2;
+      ScrWork[SW_TITLEDISPCT] = 0;
+      ScrWork[SW_TITLEMOVIECT] = 0;
+      SetFlag(SF_TITLEEND, 1);
+      ImpLog(LogLevel::Info, LogChannel::VM, "Script title: press-to-start accepted\n");
+    } else {
+      ScrWork[SW_TITLEMOVIECT]++;
+    }
+    return;
+  }
+  if (mode != 3) return;
+  if (PADinputButtonWentDown & PAD1DOWN) Cursor = (Cursor + 1) % Ids.size();
+  if (PADinputButtonWentDown & PAD1UP) Cursor = (Cursor + Ids.size() - 1) % Ids.size();
+  bool hovered = false;
+  for (size_t i = 0; i < Positions.size(); ++i) {
+    const auto bounds = Profile::TitleMenu::MenuEntriesSprites[i].ScaledBounds().Translate(Positions[i]);
+    if (Input::CurMousePos.x >= bounds.X && Input::CurMousePos.x <= bounds.X + bounds.Width &&
+        Input::CurMousePos.y >= bounds.Y && Input::CurMousePos.y <= bounds.Y + bounds.Height) {
+      Cursor = i;
+      hovered = true;
+    }
+  }
+  if ((PADinputButtonWentDown & PAD1A) ||
+      (hovered && Input::MouseButtonWentDown[SDL_BUTTON_LEFT])) {
+    ScrWork[SW_TITLECUR1] = Ids[Cursor];
+    ScrWork[SW_TITLECUR2] = 255;
+    ChoiceMade = true;
+    SetFlag(SF_TITLEEND, 1);
+    ImpLog(LogLevel::Info, LogChannel::VM, "Script title: selected {}\n", Ids[Cursor]);
+  }
+}
+void ScriptSpriteMenu::Render() {
+  const int mode = ScrWork[SW_TITLEMODE];
+  if (!Enabled || !GetFlag(SF_TITLEMODE) || mode == 0) return;
+  Renderer->DrawSprite(Background, BackgroundPos);
+  if (CompositeVideo) Video::VideoRender(ScrWork[SW_MOVIEALPHA] / 256.0f);
+  if (mode == 1 || mode == 2) {
+    Renderer->DrawSprite(Profile::TitleMenu::PressToStartSprite,
+                         Profile::TitleMenu::PressToStartPos);
+  } else if (mode == 3) {
+    for (size_t i = 0; i < Positions.size(); ++i) {
+      const Sprite& sprite = i == Cursor ? Profile::TitleMenu::MenuEntriesHSprites[i]
+                                         : Profile::TitleMenu::MenuEntriesSprites[i];
+      Renderer->DrawSprite(sprite, Positions[i]);
+    }
+  }
+}
+}  // namespace Impacto::UI
