+#pragma once
+
+#include "menu.h"
+#include "../spritesheet.h"
+
+namespace Impacto::UI {
+// A profile-described title menu driven by the SC3 title mode register.
+// Assets and choices belong to the profile; this implementation has no title ids.
+class ScriptSpriteMenu : public Menu {
+ public:
+  ScriptSpriteMenu(Sprite background, glm::vec2 backgroundPos,
+                   std::vector<glm::vec2> positions, std::vector<int> ids);
+  void SetCompositeVideo(bool enabled) { CompositeVideo = enabled; }
+  void Init() override;
+  void SetEnabled(bool enabled);
+  void Update(float dt) override {}
+  void Tick(float dt);
+  void Render() override;
+ private:
+  Sprite Background;
+  glm::vec2 BackgroundPos;
+  std::vector<glm::vec2> Positions;
+  std::vector<int> Ids;
+  size_t Cursor = 0;
+  bool Enabled = false;
+  bool CompositeVideo = false;
+  int LastMode = -1;
+  int LastFlag = -1;
+};
+}  // namespace Impacto::UI
