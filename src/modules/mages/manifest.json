{
  "id": "mages",
  "label": "MAGES.",
  "shortLabel": "MAGES.",
  "family": "visual-novel",
  "gameType": "scripted",
  "icon": {
    "path": "resources/icon.png",
    "kind": "symbol"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file"
    ],
    "fileExtensions": [
      ".exe",
      ".mpk"
    ],
    "rootMarkers": [
      "USRDIR/script.mpk",
      "script.mpk"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".mpk"
    ],
    "allowUnmarkedDirectory": true
  },
  "runtime": {
    "default": "impacto",
    "supported": [
      "impacto"
    ],
    "manager": {
      "impacto": "impacto"
    },
    "managerUi": {
      "impacto": {
        "tabLabel": "MAGES.",
        "order": 170,
        "management": "built-in"
      }
    },
    "entries": {
      "impacto": {
        "graphicsHost": "window",
        "label": "Impacto Windows HD"
      }
    }
  },
  "settingsDefaults": {
    "defaultRuntime": "impacto"
  },
  "supports": {
    "launch": true,
    "saveLocation": false,
    "saveEditing": false,
    "cheats": false,
    "cheatsPatcher": false
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.edition",
        "label": "Data edition"
      },
      {
        "key": "moduleData.archiveFormat",
        "label": "Archive format"
      },
      {
        "key": "moduleData.scriptFormat",
        "label": "Script format"
      },
      {
        "key": "moduleData.originalRunner.fileVersion",
        "label": "Original executable version"
      },
      {
        "key": "moduleData.originalRunner.productVersion",
        "label": "Original product version"
      },
      {
        "key": "moduleData.originalRunner.source",
        "label": "Version source"
      },
      {
        "key": "moduleData.compatibility",
        "label": "Native support"
      },
      {
        "key": "moduleData.nativeRuntimeVersion",
        "label": "Native runtime"
      },
      {
        "key": "moduleData.nativeMinimumMacOS",
        "label": "Native runtime macOS minimum"
      }
    ],
    "actions": [
      {
        "id": "inspectArchives",
        "label": "Inspect archives",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "edition",
            "label": "Data edition"
          },
          {
            "key": "archiveCount",
            "label": "Validated archives"
          },
          {
            "key": "indexBytes",
            "label": "Index bytes read"
          },
          {
            "key": "complete",
            "label": "Complete",
            "format": "boolean"
          }
        ]
      },
      {
        "id": "inspectScripts",
        "label": "Inspect scripts",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "programCount",
            "label": "Compiled scripts"
          },
          {
            "key": "scriptFormat",
            "label": "Format"
          },
          {
            "key": "scriptBytes",
            "label": "Decoded bytes"
          },
          {
            "key": "complete",
            "label": "Complete",
            "format": "boolean"
          }
        ]
      },
      {
        "id": "exportScripts",
        "label": "Export compiled scripts",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "path",
            "label": "Export",
            "format": "path"
          },
          {
            "key": "programCount",
            "label": "Scripts"
          },
          {
            "key": "format",
            "label": "Format"
          },
          {
            "key": "complete",
            "label": "Complete",
            "format": "boolean"
          }
        ]
      }
    ]
  },
