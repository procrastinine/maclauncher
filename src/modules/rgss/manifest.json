            "printFPS": false,
            "fullscreen": false,
            "fixedAspectRatio": true,
            "winResizable": true,
            "vsync": false,
            "defScreenW": 0,
            "defScreenH": 0,
            "windowTitle": "",
            "fixedFramerate": 0,
            "frameSkip": false,
            "syncToRefreshrate": false,
            "smoothScaling": "0",
            "smoothScalingDown": "0",
            "bitmapSmoothScaling": "0",
            "bitmapSmoothScalingDown": "0",
            "smoothScalingMipmaps": false,
