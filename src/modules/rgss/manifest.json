{
  "id": "rgss",
  "distributionSupplementals": {
    "path": "runtime/distribution-supplementals.json"
  },
  "icon": {
    "path": "resources/icon.png",
    "kind": "symbol"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file"
    ],
    "fileExtensions": [
      ".exe",
      ".ini",
      ".rgssad",
      ".rgss2a",
      ".rgss3a"
    ],
    "rootMarkers": [
      "Game.ini",
      "Data/Scripts.rxdata",
      "Data/Scripts.rvdata",
      "Data/Scripts.rvdata2"
    ],
    "rootExtensions": [
      ".rgssad",
      ".rgss2a",
      ".rgss3a",
      ".dll"
    ],
    "containerFormats": [
      "zip",
      "rar",
      "7z",
      "nsis",
      "inno",
      "cab",
      "enigma"
    ],
    "directFileExtensions": [
      ".ini",
      ".rgssad",
      ".rgss2a",
      ".rgss3a"
    ],
    "directoryFileExtensions": [
      ".exe"
    ],
    "worker": true
  },
  "family": "rpgmaker",
  "label": "RPG Maker XP/VX/VX Ace",
  "shortLabel": "RPG Maker XP/VX/VX Ace",
  "gameType": "rgss",
  "runtime": {
    "managerUi": {
      "mkxpz": {
        "tabLabel": "MKXP-Z",
        "order": 20,
        "management": "managed"
      }
    },
    "default": "mkxpz",
    "supported": [
      "mkxpz"
    ],
    "entries": {
