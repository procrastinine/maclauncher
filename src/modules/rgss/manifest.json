    "labels": {
      "mkxpz": "MKXP-Z"
    },
    "manager": {
      "mkxpz": "mkxpz"
    },
    "preLaunch": {
      "mkxpz": {
        "statusAction": "refreshSetupStatus",
        "readyWhen": {
          "key": "assetsStaged",
          "equals": true
        },
        "fixAction": "stageAssets"
      }
    }
