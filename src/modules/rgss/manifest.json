            "midiReverb": false,
            "SESourceCount": 6,
            "BGMTrackCount": 1,
            "JITEnable": false,
            "JITVerboseLevel": 0,
            "JITMaxCache": 100,
            "JITMinCalls": 10000,
            "YJITEnable": false,
            "patches": [],
