  "supports": {
    "cheats": true,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "mkxpz"
  },
  "ui": {
    "infoFields": [],
    "actions": [
      {
        "id": "refreshRgssTools",
        "label": "Reload tools",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "scriptArchivePath",
            "label": "Script archive"
          },
          {
            "key": "scriptsExportDir",
            "label": "Export folder"
          },
          {
            "key": "scriptsExportCount",
            "label": "Scripts exported"
          }
        ]
      },
      {
        "id": "exportScripts",
        "label": "Export Ruby scripts",
        "kind": "primary",
        "resultFields": [
          {
            "key": "outputDir",
            "label": "Export folder"
          },
          {
            "key": "scriptCount",
            "label": "Scripts"
          }
        ]
      },
      {
        "id": "revealScripts",
        "label": "Reveal scripts",
        "kind": "secondary",
        "icon": "folder",
        "disabledWhen": [
          {
            "key": "moduleData.scriptsExportReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "repackScripts",
        "label": "Repack edited scripts",
        "kind": "secondary",
        "disabledWhen": [
          {
            "key": "moduleData.scriptsExportReady",
            "falsy": true
          }
        ],
        "resultFields": [
          {
            "key": "outputPath",
            "label": "Repacked archive"
          },
          {
            "key": "changedCount",
            "label": "Edited scripts"
          }
        ]
      },
      {
        "id": "discoverSaves",
        "label": "Find portable saves",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "saveFileCount",
            "label": "Save files found"
          },
          {
            "key": "outputPath",
            "label": "Discovery report"
          }
        ]
      },
      {
        "id": "inspectRgssFile",
        "label": "Inspect save or database",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "nodeCount",
            "label": "Graph nodes"
          },
          {
            "key": "streamCount",
            "label": "Marshal streams"
          },
          {
            "key": "outputPath",
            "label": "Inspection report"
          }
        ]
      },
      {
        "id": "refreshSetupStatus",
        "label": "Reload",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true
      },
      {
        "id": "revealAssets",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.assetsStaged",
            "falsy": true
          }
        ]
      },
      {
        "id": "stageAssets",
        "label": "Extract runtime assets",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.assetsStaged",
            "truthy": true
          }
        ]
      },
      {
        "id": "removeAssets",
        "label": "Remove runtime assets",
        "kind": "danger",
        "confirm": "Remove extracted RGSS runtime assets?",
        "hiddenWhen": [
          {
            "key": "moduleData.assetsStaged",
            "falsy": true
          }
        ]
      },
      {
        "id": "refreshDecryptionStatus",
        "label": "Reload",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "decryptStatusLabel",
            "label": "Status"
          },
          {
            "key": "decryptedAt",
            "label": "Last extract",
            "format": "date"
          }
        ]
      },
      {
        "id": "revealDecryption",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.decryptedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "reconstructProject",
        "label": "Extract",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.decryptedReady",
            "truthy": true
          }
        ]
      },
      {
        "id": "removeDecryption",
        "label": "Remove Extracted",
        "kind": "danger",
        "confirm": "Remove extracted RGSS files?",
        "hiddenWhen": [
          {
            "key": "moduleData.decryptedReady",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "scripts",
        "label": "Ruby scripts",
