            "dataPathOrg": "",
            "dataPathApp": "",
            "iconPath": "",
            "solidFonts": [],
            "fontSub": [],
            "fontScale": 1,
            "fontKerning": true,
            "fontHinting": "3",
            "fontHeightReporting": "0",
            "fontOutlineCrop": true,
            "rubyLoadpath": [],
