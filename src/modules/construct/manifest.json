{
  "id": "construct",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "fileExtensions": [
      ".exe",
      ".nw",
      ".html",
      ".htm"
    ],
    "rootMarkers": [
      "package.nw"
    ],
    "webContent": true,
    "webRoots": [
      "package.nw",
      "Contents/Resources/app.nw"
    ],
    "containerFormats": [
      "zip"
    ],
    "directFileExtensions": [
      ".html",
      ".htm"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".nw"
    ],
    "worker": true
  },
  "family": "web",
  "label": "Construct",
  "shortLabel": "Construct",
  "gameType": "web",
  "runtime": {
    "default": "electron",
    "supported": [
      "electron",
      "nwjs",
      "nwjs-patched",
      "native"
    ],
    "entries": {
      "electron": {
        "label": "Electron",
        "graphicsHost": "remote",
        "settings": {
          "defaults": {
            "enableProtections": true
          },
          "fields": [
            {
              "key": "enableProtections",
              "type": "boolean",
              "label": "Enable protections"
            }
          ]
        }
      },
      "nwjs": {
        "label": "NW.js",
        "graphicsHost": "remote",
        "settings": {
          "defaults": {
            "enableProtections": true
          },
          "fields": [
            {
              "key": "enableProtections",
              "type": "boolean",
              "label": "Enable protections"
            }
          ]
        }
      },
      "nwjs-patched": {
        "label": "NW.js (Patched)",
        "graphicsHost": "remote",
        "settings": {
          "defaults": {
            "enableProtections": true,
            "caseInsensitive": false,
            "enableUserScripts": false
          },
          "fields": [
            {
              "key": "enableProtections",
              "type": "boolean",
              "label": "Enable protections"
            },
            {
              "key": "caseInsensitive",
              "type": "boolean",
              "label": "Enable case-insensitive assets"
            },
            {
              "key": "enableUserScripts",
              "type": "boolean",
              "label": "Enable user scripts"
            }
          ]
        }
      },
      "native": {
        "graphicsHost": "window",
        "label": "Native app"
      }
    },
    "labels": {
      "electron": "Electron",
      "nwjs": "NW.js",
      "nwjs-patched": "NW.js (Patched)",
      "native": "Native app"
    },
    "hosted": {
      "id": "electron",
      "fallback": "nwjs"
    },
    "manager": {
      "nwjs": "nwjs",
      "nwjs-patched": "nwjs"
    },
    "preLaunch": {
      "electron": {
        "statusAction": "refreshExtractionStatus",
        "readyWhen": {
          "key": "extractedReady",
          "equals": true
        },
        "fixAction": "extractGame",
        "prompt": "This Construct bundle needs extraction before it can launch. Extract now?"
      },
      "nwjs": {
        "statusAction": "refreshExtractionStatus",
        "readyWhen": {
          "key": "extractedReady",
          "equals": true
        },
        "fixAction": "extractGame",
        "prompt": "This Construct bundle needs extraction before it can launch. Extract now?"
      },
      "nwjs-patched": {
        "statusAction": "refreshExtractionStatus",
        "readyWhen": {
          "key": "extractedReady",
          "equals": true
        },
        "fixAction": "extractGame",
        "prompt": "This Construct bundle needs extraction before it can launch. Extract now?"
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "electron"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.constructRuntime",
        "label": "Construct runtime"
      }
    ],
    "actions": [
      {
        "id": "refreshExtractionStatus",
        "label": "Refresh status",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "hiddenWhen": [
          {
            "key": "moduleData.packagedType",
            "falsy": true
          }
        ],
        "resultFields": [
          {
            "key": "extractedReady",
            "label": "Extracted",
            "format": "boolean"
          },
          {
            "key": "extractionStatus",
            "label": "Next step"
          },
          {
            "key": "extractedRoot",
            "label": "Output folder",
            "format": "path"
          }
        ]
      },
      {
        "id": "extractGame",
        "label": "Extract bundle",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "truthy": true
          }
        ]
      },
      {
        "id": "revealExtraction",
        "label": "Reveal extracted files",
        "disabledWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "removeExtraction",
        "label": "Remove extracted files",
        "kind": "danger",
        "confirm": "Remove extracted Construct files?",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          },
          {
            "key": "moduleData.extractedRoot",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "bundle",
        "label": "Bundle",
        "actions": [
          "refreshExtractionStatus",
          "extractGame",
          "revealExtraction",
          "removeExtraction"
        ],
        "hiddenWhen": [
          {
            "key": "moduleData.packagedType",
            "falsy": true
          }
        ],
        "note": "Packaged web resources are extracted to the launcher data folder. Play prepares them automatically."
      }
    ]
  }
}
