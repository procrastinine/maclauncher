{
  "id": "window",
  "label": "Window",
  "shortLabel": "Window",
  "family": "native",
  "gameType": "window",
  "icon": {
    "path": "resources/icon.png",
    "kind": "symbol"
  },
  "runtime": {
    "default": "capture",
    "supported": [
      "capture"
    ],
    "providers": [],
    "entries": {
      "capture": {
        "label": "Window capture",
        "graphicsHost": "window",
        "explicitFrames": true,
        "settings": {
          "defaults": {
            "output": "inPlace",
            "captureCursor": false,
            "showPointer": true
          },
          "fields": [
            {
              "key": "output",
              "type": "select",
              "label": "Output",
              "description": "Scaled output keeps the window’s aspect ratio and needs the Accessibility permission. A display is always shown in place.",
              "options": [
                {
                  "value": "inPlace",
                  "label": "In place"
                },
                {
                  "value": "scaled",
                  "label": "Fit screen"
                },
                {
                  "value": "scale150",
                  "label": "1.5×"
                },
                {
                  "value": "scale200",
                  "label": "2×"
                },
                {
                  "value": "scale250",
                  "label": "2.5×"
                },
                {
                  "value": "scale300",
                  "label": "3×"
                },
                {
                  "value": "scale400",
                  "label": "4×"
                },
                {
                  "value": "scale500",
                  "label": "5×"
                },
                {
                  "value": "scale600",
                  "label": "6×"
                },
                {
                  "value": "scale800",
                  "label": "8×"
                },
                {
                  "value": "scale1000",
                  "label": "10×"
                }
              ]
            },
            {
              "key": "captureCursor",
              "type": "boolean",
              "label": "Include pointer in capture",
              "description": "Effects also apply to the pointer. Changes apply while the window has graphics."
            },
            {
              "key": "showPointer",
              "type": "boolean",
              "label": "Show pointer in picture",
              "description": "Show the pointer in scaled output.",
              "default": true
            }
          ]
        }
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {},
  "ui": {
    "appActions": [
      {
        "id": "applyGraphics",
        "label": "Apply Graphics…",
        "menus": [
          "file",
          "dock"
        ],
        "picker": true,
        "stopLabel": "Stop Window Graphics",
        "shortcut": "windowGraphics",
        "sessionShortcuts": [
          {
            "shortcut": "windowPointer",
            "action": "windowTogglePointer"
          }
        ]
      }
    ]
  }
}
