{
  "id": "kirikiri",
  "icon": {
    "path": "resources/icon.png",
    "kind": "logo"
  },
  "family": "scripted",
  "label": "KiriKiri (experimental)",
  "shortLabel": "KiriKiri",
  "gameType": "scripted",
  "detection": {
    "inputKinds": [
      "directory",
      "file",
      "app"
    ],
    "fileExtensions": [
      ".exe",
      ".xp3",
      ".tjs"
    ],
    "rootMarkers": [
      "startup.tjs",
      "Contents/Resources/game",
      "Contents/Resources/data",
      "Contents/Resources"
    ],
    "rootExtensions": [
      ".xp3"
    ],
    "directoryFileExtensions": [
      ".exe",
      ".xp3"
    ]
  },
  "runtime": {
    "managerUi": {
      "krkrsdl2": {
        "tabLabel": "KiriKiri",
        "order": 100,
        "management": "built-in"
      }
    },
    "default": "krkrsdl2",
    "supported": [
      "krkrsdl2"
    ],
    "manager": {
      "krkrsdl2": "krkrsdl2"
    },
    "entries": {
      "krkrsdl2": {
        "label": "KiriKiri SDL2",
        "settings": {
          "defaults": {
            "version": "auto",
            "runtimePath": "",
            "sourcePath": "",
            "args": []
          },
          "fields": [
            {
              "key": "version",
              "type": "select",
              "label": "Version",
              "options": [
                {
                  "value": "auto",
                  "label": "Runtime default"
                },
                {
                  "value": "snapshot-124bdf8-macos-v3",
                  "label": "124bdf8 · Mac 3"
                },
                {
                  "value": "snapshot-124bdf8-macos-v2",
                  "label": "124bdf8 · Mac 2"
                },
                {
                  "value": "snapshot-124bdf8",
                  "label": "Snapshot 124bdf8"
                }
              ]
            },
            {
              "key": "runtimePath",
              "type": "string",
              "label": "Local macOS build",
              "description": "Optional local executable or app."
            },
            {
              "key": "sourcePath",
              "type": "string",
              "label": "Source checkout",
              "description": "Optional clean checkout for a local source build."
            },
            {
              "key": "args",
              "type": "list",
              "label": "Extra runtime options",
              "description": "One option per line."
            }
          ]
        }
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": true
  },
  "settingsDefaults": {
    "defaultRuntime": "krkrsdl2"
  },
  "ui": {
    "infoFields": [
      {
        "key": "moduleData.detectedVersion",
        "label": "Detected engine/script version"
      },
      {
        "key": "moduleData.engineGeneration",
        "label": "Engine family"
      },
      {
        "key": "moduleData.detectedVersionConfidence",
        "label": "Version confidence"
      },
      {
        "key": "moduleData.detectedVersionSource",
        "label": "Version evidence"
      },
      {
        "key": "moduleData.compatibility",
        "label": "Compatibility"
      },
      {
        "key": "moduleData.sourceKind",
        "label": "Source"
      },
      {
        "key": "moduleData.kagSaveRouting",
        "label": "KAG save routing"
      }
    ],
    "actions": [
      {
        "id": "runtimeStatus",
        "label": "Runtime Status",
        "kind": "secondary",
        "autoRun": true,
        "resultFields": [
          {
            "key": "version",
            "label": "Selected version"
          },
          {
            "key": "upstreamRevision",
            "label": "Source revision"
          },
          {
            "key": "runtimePath",
            "label": "Executable",
            "format": "path"
          },
          {
            "key": "sha256",
            "label": "SHA-256"
          },
          {
            "key": "reason",
            "label": "Status"
          }
        ]
      },
      {
        "id": "registerRuntime",
        "label": "Register Runtime",
        "kind": "primary",
        "resultFields": [
          {
            "key": "version",
            "label": "Registered version"
          },
          {
            "key": "sha256",
            "label": "SHA-256"
          }
        ]
      },
      {
        "id": "buildRuntime",
        "label": "Build Runtime",
        "kind": "secondary",
        "resultFields": [
          {
            "key": "version",
            "label": "Built version"
          },
          {
            "key": "logPath",
            "label": "Build log",
            "format": "path"
          },
          {
            "key": "sha256",
            "label": "SHA-256"
          },
          {
            "key": "provenanceVerified",
            "label": "Source integrity",
            "format": "boolean"
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "runtime",
        "label": "Advanced",
        "collapsed": true,
        "actions": [
          "runtimeStatus",
          "registerRuntime",
          "buildRuntime"
        ],
        "note": "Optional local runtime builds and registration."
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "KiriKiri SDL2",
      "url": "https://github.com/krkrsdl2/krkrsdl2"
    },
    {
      "label": "KAG3 compatibility scripts",
      "url": "https://github.com/krkrsdl2/kag3"
    },
    {
      "label": "KiriKiri Z source components",
      "url": "https://github.com/krkrsdl2/krkrz"
    },
    {
      "label": "SIMDe",
      "url": "https://github.com/simd-everywhere/simde"
    }
  ]
}
