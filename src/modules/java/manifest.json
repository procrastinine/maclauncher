{
  "id": "java",
  "icon": {
    "path": "resources/icon.png",
    "kind": "symbol"
  },
  "detection": {
    "inputKinds": [
      "directory",
      "file"
    ],
    "extensions": [
      {
        "extension": ".jar",
        "exclusive": true
      }
    ],
    "fileExtensions": [
      ".jar"
    ],
    "rootExtensions": [
      ".jar"
    ],
    "worker": true
  },
  "family": "scripted",
  "label": "Java",
  "shortLabel": "Java",
  "distributionSupplementals": {
    "path": "runtime/steamworks/distribution-supplementals.json"
  },
  "gameType": "scripted",
  "runtime": {
    "managerUi": {
      "java": {
        "tabLabel": "Java (Temurin)", "sectionLabel": "Java (Temurin)",
        "order": 50,
        "management": "managed"
      }
    },
    "default": "java",
    "supported": [
      "java"
    ],
    "entries": {
      "java": {
        "graphicsHost": "window",
        "label": "Java (Temurin)",
        "settings": {
          "defaults": {
            "vmArgs": [],
            "appArgs": [],
            "workingDir": "jar-dir"
          },
          "fields": [
            {
              "key": "vmArgs",
              "type": "list",
              "label": "JVM arguments",
              "description": "One argument per line."
            },
            {
              "key": "appArgs",
              "type": "list",
              "label": "Application arguments",
              "description": "One argument per line."
            },
            {
              "key": "workingDir",
              "type": "select",
              "label": "Working directory",
              "options": [
                {
                  "value": "jar-dir",
                  "label": "Jar directory"
                },
                {
                  "value": "game-dir",
                  "label": "Game directory"
                }
              ]
            }
          ]
        }
      }
    },
    "labels": {
      "java": "Java"
    },
    "manager": {
      "java": "java"
    },
    "managerSectionBy": {
      "java": "runtimeLine"
    },
    "managerSectionAuto": {
      "java": {
        "defaultKey": "defaultLine",
        "minimumKey": "minimumLine"
      }
    },
    "managerVersionSectionBy": {
      "java": "major"
    },
    "managerSectionOverrideKey": {
      "java": "line"
    },
    "managerSectionMap": {
      "java": {
        "8": "8",
        "11": "11",
        "17": "17",
        "21": "21",
        "25": "25"
      }
    },
    "preLaunch": {
      "java": {
        "statusAction": "runtimeStatus",
        "readyWhen": {
          "key": "ready",
          "equals": true
        },
        "fixAction": "installRuntime",
        "prompt": "This game needs a compatible Java runtime before it can launch. Install it now?"
      }
    }
  },
  "supports": {
    "cheats": false,
    "cheatsPatcher": false,
    "saveEditing": false,
    "saveLocation": false
  },
  "settingsDefaults": {
    "defaultRuntime": "java"
  },
  "ui": {
    "infoFields": [],
    "actions": [
      {
        "id": "refreshExtractionStatus",
        "label": "Refresh status",
        "kind": "secondary",
        "icon": "refresh",
        "iconOnly": true,
        "autoRun": true,
        "resultFields": [
          {
            "key": "extractStatusLabel",
            "label": "Status"
          },
          {
            "key": "extractedAt",
            "label": "Last extract",
            "format": "date"
          }
        ]
      },
      {
        "id": "revealExtraction",
        "label": "Reveal",
        "kind": "secondary",
        "icon": "folder",
        "iconOnly": true,
        "disabledWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      },
      {
        "id": "extractGame",
        "label": "Decompile Java",
        "kind": "primary",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "truthy": true
          }
        ],
        "resultFields": [
          {
            "key": "extractedRoot",
            "label": "Output folder",
            "format": "path"
          },
          {
            "key": "vineflowerVersion",
            "label": "Vineflower"
          }
        ]
      },
      {
        "id": "removeExtraction",
        "label": "Remove decompiled files",
        "kind": "danger",
        "confirm": "Remove decompiled Java files?",
        "hiddenWhen": [
          {
            "key": "moduleData.extractedReady",
            "falsy": true
          }
        ]
      }
    ],
    "actionGroups": [
      {
        "id": "extract",
        "label": "Source",
        "actions": [
          "extractGame",
          "revealExtraction",
          "refreshExtractionStatus",
          "removeExtraction"
        ],
        "note": "Vineflower decompiles Java classes to the launcher data folder. The original JAR is preserved."
      }
    ]
  },
  "acknowledgments": [
    {
      "label": "Eclipse Temurin (Adoptium)",
      "url": "https://adoptium.net/"
    },
    {
      "label": "Vineflower",
      "url": "https://github.com/Vineflower/vineflower"
    },
    {
      "label": "steamworks4j",
      "url": "https://github.com/code-disaster/steamworks4j"
    }
  ]
}
